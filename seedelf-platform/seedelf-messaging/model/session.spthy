/*
 * Seedelf Messaging's one-to-one sessions: protocol.md §3 to §6, as built
 * (§16), in Tamarin. Chunk 54's 54b. Run it with ./check.sh; the README
 * says what is modelled, what isn't, and why.
 *
 * Six configurations, by flag, sharing the handles and first contact:
 *   (none)              the ratchet over two round trips, long-term keys and
 *                       the initiator's state stolen, and the sessions' lemmas;
 *   -D=RESPONDER_STATE  the same with the responder's state stolen instead;
 *   -D=CONTINUATIONS    §6's continuations instead of the ratchet, and theirs;
 *   -D=NO_CID_RULE      the sessions without §5's cid rule, to find a replay;
 *   -D=REVEAL           §19's verified reveal instead of the ratchet;
 *   -D=SKIPPED          the ratchet to a chain of two messages, read in either
 *                       order, and a kept skipped key stolen.
 * Tamarin's search grows with every rule that publishes a power of G, so
 * each lemma sees only the rules it needs; the README says what each
 * configuration's attacker lacks, and why that loses no attack.
 *
 * Notation follows the spec: p0 is the conversation's base, Ai = [x_A]p0 is
 * R_A's public value, w0 = [x_B]p0 is R_B's, Ei the session ephemeral, Si,
 * S2, S3 the initiator's ratchet keys and T1, T2 the responder's. A point
 * [k]P is P^k. Principals are $Ini (wrote first) and $Rsp (was written to),
 * roles not people: every principal plays both.
 */

theory SeedelfMessagingSessions
begin

builtins: diffie-hellman

/* AES-256-GCM: anyone with the key reads (adec takes no associated data);
   a reader accepts only a ciphertext under its own key and associated data,
   by matching aenc(m, mk, ad). The HKDF and HMAC steps of §16.2 are one-way
   functions. ENCRYPT's salt is left out (README). */
functions: aenc/3, adec/2,
           kdf_sk/3, kdf_root/2, kdf_chain/2, ck_next/1, ck_mk/1
equations: adec(aenc(m, k, ad), k) = m

restriction neq: "All x y #i. Neq(x, y)@i ==> not (x = y)"
restriction one_handle: "All P #i #j. OneHandle(P)@i & OneHandle(P)@j ==> #i = #j"

/* What §5's rules aim at: a reader takes a cid's first message once. The
   cid table, the tombstones and the window keep it in the code, but for one
   gap (README); -D=NO_CID_RULE drops it, to show it's needed. */
#ifdef not NO_CID_RULE
restriction unique_cid: "All R c #i #j. RNewCid(R, c)@i & RNewCid(R, c)@j ==> #i = #j"
#endif

/* ---- Handles and keys ---- */

/* A Seedelf's datum register, as a root register (G, [x]G): README. */
rule Handle:
  [ Fr(~ltk) ] --[ Handle($P, ~ltk), OneHandle($P) ]-> [ !Ltk($P, ~ltk), !Pk($P, 'g'^~ltk), Out('g'^~ltk) ]

rule Reveal_ltk:
  [ !Ltk(P, x) ] --[ RevLtk(P) ]-> [ Out(x) ]

/* Observers, never published: KeyOn(P, p0, A) marks A = [x_P]p0, so a lemma
   can say "R_A is P's key" without a power in its formula. */
rule Key_on_honest_base:
  [ !Ltk(P, ~x), !Base(~rb) ] --[ KeyOn(P, 'g'^~rb, 'g'^(~rb*~x)) ]-> [ ]

rule Key_on_attacker_base:
  [ !Ltk(P, ~x), In($k) ] --[ KeyOn(P, 'g'^$k, 'g'^($k*~x)) ]-> [ ]

/* ---- The initiator (§3) ---- */

/* Both identities, F, SK with the static DH, RatchetInitAlice, and the
   first first-contact message (N = 0). */
rule I_Start:
  let p0  = 'g'^~rb
      w0  = pkr^~rb
      Ai  = p0^~xi
      Ei  = p0^~ei
      Si  = p0^~si
      F   = <~cid, $t, 'none', p0, Ai, Ei>
      SK  = kdf_sk(w0^~ei, w0^~xi, F)
      RK1 = kdf_root(SK, w0^~si)
      CK  = kdf_chain(SK, w0^~si)
      h   = <Si, '0', '0'>
      ad  = <~cid, p0, Ai, p0, w0, h>
  in
  [ !Ltk($Ini, ~xi), !Pk($Rsp, pkr), Fr(~rb), Fr(~cid), Fr(~ei), Fr(~si), Fr(~m1) ]
  --[ Neq($Ini, $Rsp), IStart($Ini, $Rsp, ~cid, p0, Ai, w0, F), HasConv($Ini, ~cid),
      ISent($Ini, $Rsp, ~cid, 'm1', ~m1), IKeys($Ini, $Rsp, ~cid, 'k1', RK1, CK) ]->
  [ !Base(~rb), !Conv($Ini, ~cid, ~rb, Ai, w0), !Side($Ini, ~cid, ~rb, Ai, w0),
    I1($Ini, $Rsp, ~cid, ~rb, Ai, w0, ~si, RK1),
    Out(<'0x01', F, h, aenc(~m1, ck_mk(CK), ad)>) ]

/* ---- The responder (§3, Bob's side) ---- */

/* p0 is an honest initiator's base, or G^k for a k the attacker chose
   (README, assumption 4). */
rule R_Derive_m1a_honest_base:
  let p0 = 'g'^~rb
      F  = <cid, t, rep, p0, Ai, Ei>
  in
  [ !Ltk($Rsp, ~xr), !Base(~rb), In(<'0x01', F, <Si, '0', '0'>>) ]
  --[ RStatic($Rsp, p0, Ai, Ai^~xr) ]->
  [ R0a($Rsp, ~xr, F, ~rb, Si, p0^~xr, Ai^~xr) ]

rule R_Derive_m1a_attacker_base:
  let p0 = 'g'^$k
      F  = <cid, t, rep, p0, Ai, Ei>
  in
  [ !Ltk($Rsp, ~xr), In($k), In(<'0x01', F, <Si, '0', '0'>>) ]
  --[ RStatic($Rsp, p0, Ai, Ai^~xr) ]->
  [ R0a($Rsp, ~xr, F, $k, Si, p0^~xr, Ai^~xr) ]

/* SK from [x_B]E_A and [x_B]A, RatchetInitBob with (x_B, w0), and the
   step from Si: the receiving chain. */
rule R_Derive_m1b:
  let p0  = 'g'^e0
      F   = <cid, t, rep, p0, Ai, Ei>
      SK  = kdf_sk(Ei^~xr, sdh, F)
      RK1 = kdf_root(SK, Si^~xr)
      CKr = kdf_chain(SK, Si^~xr)
      h   = <Si, '0', '0'>
      ad  = <cid, p0, Ai, p0, w0, h>
  in
  [ R0a(Rsp, ~xr, F, e0, Si, w0, sdh) ]
  -->
  [ R0b(Rsp, F, e0, Si, w0, RK1, ad, ck_mk(CKr)) ]

/* It authenticates: a request, read as replying would (§3.1, §16.4). Then
   the ratchet's sending half, with a fresh T1. */
rule R_Read_m1:
  let p0  = 'g'^e0
      F   = <cid, t, rep, p0, Ai, Ei>
      h   = <Si, '0', '0'>
      RK2 = kdf_root(RK1, Si^~t1)
      CKs = kdf_chain(RK1, Si^~t1)
  in
  [ R0b(Rsp, F, e0, Si, w0, RK1, ad, mk), In(<'0x01', F, h, aenc(m, mk, ad)>), Fr(~t1) ]
  --[ RNewCid(Rsp, cid), RAccept(Rsp, cid, p0, Ai, w0, F),
      RRecv(Rsp, cid, p0, Ai, w0, 'm1', m), RKeys(Rsp, cid, 'k2', RK2, CKs) ]->
  [ !Accepted(Rsp, cid, e0, Ai, w0, rep),
    R1(Rsp, cid, e0, Ai, w0, ~t1, Si, RK2, CKs) ]

#ifdef CONTINUATIONS

/* ---- Continuing (§6, §16.3) ---- */

/* A request becomes a conversation when the reader replies (§3.1); only a
   conversation can be continued or matched. The reply itself isn't needed
   here. One link: a conversation that is itself a continuation isn't
   continued again (README). */
rule R_Reply_c:
  [ R1(Rsp, cid, e0, Ai, w0, ~t1, Si, RK, CKs), !Accepted(Rsp, cid, e0, Ai, w0, 'none') ]
  --[ HasConv(Rsp, cid) ]->
  [ !Conv(Rsp, cid, e0, Ai, w0), !Side(Rsp, cid, e0, w0, Ai) ]

/* Either side continues with the old identities: the old base, its own old
   public value as the new A, the other side's as the new w0, and `replaces`
   naming the old cid. !Side holds (base, mine, theirs). Keys first, in a
   rule that publishes nothing, then the message, as the reads are split. */
rule C_Derive:
  let p0  = 'g'^e0
      Ei  = p0^~ei
      F   = <~cid, $t, ocid, p0, mine, Ei>
      SK  = kdf_sk(theirs^~ei, theirs^~x, F)
      CK  = kdf_chain(SK, theirs^~si)
  in
  [ !Ltk(W, ~x), !Side(W, ocid, e0, mine, theirs), Fr(~cid), Fr(~ei), Fr(~si) ]
  -->
  [ CPrep(W, ocid, ~cid, e0, mine, theirs, F, ~si, CK) ]

rule C_Send_honest_base:
  let p0  = 'g'^~rb
      Si  = p0^~si
      h   = <Si, '0', '0'>
      ad  = <cid, p0, mine, p0, theirs, h>
  in
  [ CPrep(W, ocid, cid, ~rb, mine, theirs, F, ~si, CK), Fr(~mc) ]
  --[ StartsContinuation(W, ocid, cid),
      IStartC(W, ocid, cid, p0, mine, theirs, F), ISentC(W, cid, 'm1', ~mc) ]->
  [ Out(<'0x01', F, h, aenc(~mc, ck_mk(CK), ad)>) ]

rule C_Send_attacker_base:
  let p0  = 'g'^$k
      Si  = p0^~si
      h   = <Si, '0', '0'>
      ad  = <cid, p0, mine, p0, theirs, h>
  in
  [ CPrep(W, ocid, cid, $k, mine, theirs, F, ~si, CK), Fr(~mc) ]
  --[ StartsContinuation(W, ocid, cid),
      IStartC(W, ocid, cid, p0, mine, theirs, F), ISentC(W, cid, 'm1', ~mc) ]->
  [ Out(<'0x01', F, h, aenc(~mc, ck_mk(CK), ad)>) ]

/* The reader shows "Continues" only for §6's match, judged when the request
   arrives against its conversations: the same p0, and the new A and the
   reader's own [x]p0 the old A and w0, in either order. */
rule R_Label_continues_as_responder:
  [ !Accepted(R, ncid, e0, Anew, wnew, ocid), !Conv(R, ocid, e0, Anew, wnew) ]
  --[ ShowsContinues(R, ocid, ncid, 'g'^e0, Anew), Judged(R, ocid, ncid) ]->
  [ ]

rule R_Label_continues_as_initiator:
  [ !Accepted(R, ncid, e0, Anew, wnew, ocid), !Conv(R, ocid, e0, wnew, Anew) ]
  --[ ShowsContinues(R, ocid, ncid, 'g'^e0, Anew), Judged(R, ocid, ncid) ]->
  [ ]

restriction judged_on_arrival:
  "All R o n #l. Judged(R, o, n)@l
     ==> Ex p A w F #c #a. HasConv(R, o)@c & RAccept(R, n, p, A, w, F)@a & #c < #a"

#endif

/* ---- Lemmas: continuations (-D=CONTINUATIONS) ---- */

#ifdef CONTINUATIONS

/* §3 and §6: a reader accepts a session whose A is P's key only if P
   started it, fresh or as a continuation, with the same cid, R_A, R_B, F,
   and reads only what P sent. First the static DH itself: [x_R]A for A of
   P's key is secret unless one of the two keys was stolen before it was
   known. Dated as the sessions' static_dh_secret is: an undated "unless"
   can't close the branch where the key is stolen after the forgery, and
   the hold on R_A ran past an hour on it (README). */

lemma static_dh_secret_with_continuations [reuse]:
  "All R p0 A s P #i #k #j.
     RStatic(R, p0, A, s)@i & KeyOn(P, p0, A)@k & KU(s)@j
     ==> (Ex #r. RevLtk(P)@r & #r < #j) | (Ex #r. RevLtk(R)@r & #r < #j)"

lemma static_dh_holds_r_a_with_continuations [reuse]:
  "All Rsp cid p0 Ai w0 F P #i #k.
     RAccept(Rsp, cid, p0, Ai, w0, F)@i & KeyOn(P, p0, Ai)@k
     ==> (Ex #s. IStart(P, Rsp, cid, p0, Ai, w0, F)@s & #s < #i)
       | (Ex o #s. IStartC(P, o, cid, p0, Ai, w0, F)@s & #s < #i)
       | (Ex #r. RevLtk(P)@r & #r < #i) | (Ex #r. RevLtk(Rsp)@r & #r < #i)"

lemma responder_agreement_m1_with_continuations:
  "All Rsp cid p0 Ai w0 m P #i #k.
     RRecv(Rsp, cid, p0, Ai, w0, 'm1', m)@i & KeyOn(P, p0, Ai)@k
     ==> (Ex F #s #t. IStart(P, Rsp, cid, p0, Ai, w0, F)@s & ISent(P, Rsp, cid, 'm1', m)@t & #t < #i)
       | (Ex o F #s #t. IStartC(P, o, cid, p0, Ai, w0, F)@s & ISentC(P, cid, 'm1', m)@t & #t < #i)
       | (Ex #r. RevLtk(P)@r & #r < #i) | (Ex #r. RevLtk(Rsp)@r & #r < #i)"

/* A continuation's message is secret unless the old other side's key is. */

lemma continuation_message_secret [hide_lemma=static_dh_secret_with_continuations,
                                   hide_lemma=static_dh_holds_r_a_with_continuations]:
  "All W o cid p0 mine theirs F m Q #s #t #k #j.
     IStartC(W, o, cid, p0, mine, theirs, F)@s & ISentC(W, cid, 'm1', m)@t
   & KeyOn(Q, p0, theirs)@k & K(m)@j
     ==> (Ex #r. RevLtk(Q)@r)"

/* §6, §7: "Continues" means the old other side's key wrote it, unless that
   key or the reader's own was stolen first. */

lemma continues_only_from_the_old_other_side [hide_lemma=static_dh_secret_with_continuations]:
  "All R ocid ncid p0 A P #i #k.
     ShowsContinues(R, ocid, ncid, p0, A)@i & KeyOn(P, p0, A)@k
     ==> (Ex #c. StartsContinuation(P, ocid, ncid)@c & #c < #i)
       | (Ex #r. RevLtk(P)@r & #r < #i) | (Ex #r. RevLtk(R)@r & #r < #i)"

/* Reachable both ways, and the reader's own key forges it (§1.1): the
   attacker, holding x_B after an honest conversation, writes a continuation
   of it on the old base with E = S = G, which any point would do. */

lemma continues_shown_to_the_old_responder [hide_lemma=static_dh_secret_with_continuations,
                                            hide_lemma=static_dh_holds_r_a_with_continuations]: exists-trace
  "Ex Ini Rsp ocid ncid p0 Ai w0 F m1 Fc mc A w #s #k #t #a #h #c #u #b #i.
     IStart(Ini, Rsp, ocid, p0, Ai, w0, F)@s & KeyOn(Ini, p0, Ai)@k & ISent(Ini, Rsp, ocid, 'm1', m1)@t
   & RRecv(Rsp, ocid, p0, Ai, w0, 'm1', m1)@a & HasConv(Rsp, ocid)@h
   & IStartC(Ini, ocid, ncid, p0, Ai, w0, Fc)@c & ISentC(Ini, ncid, 'm1', mc)@u
   & RRecv(Rsp, ncid, p0, A, w, 'm1', mc)@b & ShowsContinues(Rsp, ocid, ncid, p0, A)@i
   & not (Ex P #k. RevLtk(P)@k)"

lemma continues_shown_to_the_old_initiator [hide_lemma=static_dh_secret_with_continuations,
                                            hide_lemma=static_dh_holds_r_a_with_continuations]: exists-trace
  "Ex Ini Rsp ocid ncid p0 Ai w0 F m1 Fc mc A w #s #k #t #a #h #c #u #b #i.
     IStart(Ini, Rsp, ocid, p0, Ai, w0, F)@s & KeyOn(Rsp, p0, w0)@k & ISent(Ini, Rsp, ocid, 'm1', m1)@t
   & RRecv(Rsp, ocid, p0, Ai, w0, 'm1', m1)@a & HasConv(Rsp, ocid)@h
   & IStartC(Rsp, ocid, ncid, p0, w0, Ai, Fc)@c & ISentC(Rsp, ncid, 'm1', mc)@u
   & RRecv(Ini, ncid, p0, A, w, 'm1', mc)@b & ShowsContinues(Ini, ocid, ncid, p0, A)@i
   & not (Ex P #k. RevLtk(P)@k)"

lemma reader_key_forges_continues: exists-trace
  "Ex Ini Rsp ocid ncid p0 Ai w0 F m1 t #s #t #a #h #r #x #n #i.
     IStart(Ini, Rsp, ocid, p0, Ai, w0, F)@s & ISent(Ini, Rsp, ocid, 'm1', m1)@t
   & RRecv(Rsp, ocid, p0, Ai, w0, 'm1', m1)@a & HasConv(Rsp, ocid)@h
   & RevLtk(Rsp)@r & #h < #r
   & K(<'0x01', <ncid, t, ocid, p0, Ai, 'g'>, <'g', '0', '0'>>)@x & #r < #x
   & RAccept(Rsp, ncid, p0, Ai, w0, <ncid, t, ocid, p0, Ai, 'g'>)@n
   & ShowsContinues(Rsp, ocid, ncid, p0, Ai)@i
   & not (Ex W o c #c. StartsContinuation(W, o, c)@c) & not (Ex #q. RevLtk(Ini)@q)"

#endif

#ifdef not CONTINUATIONS & not REVEAL

/* ---- The ratchet (§4), the initiator ---- */

/* The first reply: a new receiving chain from T1, then the initiator's own
   step. Each read is two rules, derive then authenticate (README). */
rule I_Derive_r1:
  let p0  = 'g'^~rb
      h   = <T1, '0', '0'>
      ad  = <cid, p0, Ai, p0, w0, h>
      RK2 = kdf_root(RK1, T1^~si)
      CKr = kdf_chain(RK1, T1^~si)
  in
  [ I1(Ini, Rsp, cid, ~rb, Ai, w0, ~si, RK1), In(<'0x02', cid, h>) ]
  --[ Neq(T1, w0) ]->
  [ I1r(Ini, Rsp, cid, ~rb, Ai, w0, T1, RK2, CKr, ad) ]

rule I_Read_r1:
  let p0  = 'g'^~rb
      RK3 = kdf_root(RK2, T1^~s2)
      CKs = kdf_chain(RK2, T1^~s2)
  in
  [ I1r(Ini, Rsp, cid, ~rb, Ai, w0, T1, RK2, CKr, ad), In(<'0x02', cid, h, aenc(m, ck_mk(CKr), ad)>), Fr(~s2) ]
  --[ IRecv(Ini, Rsp, cid, p0, Ai, w0, 'r1', m), IGotReply(Ini, Rsp, cid), IRecvKey(Ini, cid, 'r1', T1),
      IKeys(Ini, Rsp, cid, 'k2', RK2, CKr), IKeys(Ini, Rsp, cid, 'k3', RK3, CKs) ]->
  [ I2(Ini, Rsp, cid, ~rb, Ai, w0, ~s2, T1, RK3, CKs),
    SnapI(Ini, cid, ~s2, RK3, CKs, ck_next(CKr), w0) ]

#endif

/* §1.1's "current state": the initiator's record as it was after the first
   reply, taken once, then or later. */
#ifdef not CONTINUATIONS & not RESPONDER_STATE & not REVEAL & not SKIPPED
rule Reveal_state_initiator:
  [ SnapI(Ini, cid, ~s2, RK, CKs, CKr, w0) ]
  --[ RevState(Ini, cid) ]->
  [ Out(<~s2, RK, CKs, CKr, w0>) ]
#endif

#ifdef not CONTINUATIONS & not REVEAL & not SKIPPED

rule I_Send_m3:
  let p0 = 'g'^~rb
      S2 = p0^~s2
      h  = <S2, '1', '0'>
      ad = <cid, p0, Ai, p0, w0, h>
  in
  [ I2(Ini, Rsp, cid, ~rb, Ai, w0, ~s2, T1, RK, CKs), Fr(~m3) ]
  --[ ISent(Ini, Rsp, cid, 'm3', ~m3), ISentKey(Ini, cid, 'm3', S2) ]->
  [ I3(Ini, Rsp, cid, ~rb, Ai, w0, ~s2, T1, RK),
    Out(<'0x02', cid, h, aenc(~m3, ck_mk(CKs), ad)>) ]

rule I_Derive_r2:
  let p0  = 'g'^~rb
      h   = <T2, '1', '0'>
      ad  = <cid, p0, Ai, p0, w0, h>
      RK4 = kdf_root(RK3, T2^~s2)
      CKr = kdf_chain(RK3, T2^~s2)
  in
  [ I3(Ini, Rsp, cid, ~rb, Ai, w0, ~s2, T1, RK3), In(<'0x02', cid, h>) ]
  --[ Neq(T2, T1) ]->
  [ I3r(Ini, Rsp, cid, ~rb, Ai, w0, T2, RK4, CKr, ad) ]

rule I_Read_r2:
  let p0  = 'g'^~rb
      RK5 = kdf_root(RK4, T2^~s3)
      CKs = kdf_chain(RK4, T2^~s3)
  in
  [ I3r(Ini, Rsp, cid, ~rb, Ai, w0, T2, RK4, CKr, ad), In(<'0x02', cid, h, aenc(m, ck_mk(CKr), ad)>), Fr(~s3) ]
  --[ IRecv(Ini, Rsp, cid, p0, Ai, w0, 'r2', m), IRecvKey(Ini, cid, 'r2', T2),
      IKeys(Ini, Rsp, cid, 'k4', RK4, CKr), IHeal(Ini, Rsp, cid, T2, RK5, CKs) ]->
  [ I4(Ini, Rsp, cid, ~rb, Ai, w0, ~s3, CKs) ]

rule I_Send_m4:
  let p0 = 'g'^~rb
      S3 = p0^~s3
      h  = <S3, '1', '0'>
      ad = <cid, p0, Ai, p0, w0, h>
  in
  [ I4(Ini, Rsp, cid, ~rb, Ai, w0, ~s3, CKs), Fr(~m4) ]
  --[ ISent(Ini, Rsp, cid, 'm4', ~m4) ]->
  [ Out(<'0x02', cid, h, aenc(~m4, ck_mk(CKs), ad)>) ]

#endif

#ifdef not CONTINUATIONS & not REVEAL

/* ---- The ratchet (§4), the responder ---- */

rule R_Send_r1:
  let p0 = 'g'^e0
      T1 = p0^~t1
      h  = <T1, '0', '0'>
      ad = <cid, p0, Ai, p0, w0, h>
  in
  [ R1(Rsp, cid, e0, Ai, w0, ~t1, Si, RK, CKs), Fr(~r1) ]
  --[ RSent(Rsp, cid, p0, Ai, w0, 'r1', ~r1), RSentKey(Rsp, cid, 'r1', T1) ]->
  [ R2(Rsp, cid, e0, Ai, w0, ~t1, Si, RK),
    SnapR(Rsp, cid, ~t1, RK, ck_next(CKs), w0),
    Out(<'0x02', cid, h, aenc(~r1, ck_mk(CKs), ad)>) ]

#endif

/* The responder's record after its first reply, taken once, then or later. */
#ifdef RESPONDER_STATE
rule Reveal_state_responder:
  [ SnapR(Rsp, cid, ~t1, RK, CKs, w0) ]
  --[ RevStateR(Rsp, cid) ]->
  [ Out(<~t1, RK, CKs, w0>) ]
#endif

#ifdef not CONTINUATIONS & not REVEAL & not SKIPPED

rule R_Derive_m3:
  let p0  = 'g'^e0
      h   = <S2, '1', '0'>
      ad  = <cid, p0, Ai, p0, w0, h>
      RK3 = kdf_root(RK2, S2^~t1)
      CKr = kdf_chain(RK2, S2^~t1)
  in
  [ R2(Rsp, cid, e0, Ai, w0, ~t1, Si, RK2), In(<'0x02', cid, h>) ]
  --[ Neq(S2, Si) ]->
  [ R2r(Rsp, cid, e0, Ai, w0, S2, RK3, CKr, ad) ]

rule R_Read_m3:
  let p0   = 'g'^e0
      RK4  = kdf_root(RK3, S2^~t2)
      CKs2 = kdf_chain(RK3, S2^~t2)
  in
  [ R2r(Rsp, cid, e0, Ai, w0, S2, RK3, CKr, ad), In(<'0x02', cid, h, aenc(m, ck_mk(CKr), ad)>), Fr(~t2) ]
  --[ RRecv(Rsp, cid, p0, Ai, w0, 'm3', m), RRecvKey(Rsp, cid, 'm3', S2),
      RHeal(Rsp, cid, S2, RK4, CKs2) ]->
  [ R3(Rsp, cid, e0, Ai, w0, ~t2, S2, RK4, CKs2) ]

rule R_Send_r2:
  let p0 = 'g'^e0
      T2 = p0^~t2
      h  = <T2, '1', '0'>
      ad = <cid, p0, Ai, p0, w0, h>
  in
  [ R3(Rsp, cid, e0, Ai, w0, ~t2, S2, RK, CKs), Fr(~r2) ]
  --[ RSent(Rsp, cid, p0, Ai, w0, 'r2', ~r2), RSentKey(Rsp, cid, 'r2', T2) ]->
  [ R4(Rsp, cid, e0, Ai, w0, ~t2, S2, RK),
    Out(<'0x02', cid, h, aenc(~r2, ck_mk(CKs), ad)>) ]

rule R_Derive_m4:
  let p0  = 'g'^e0
      h   = <S3, '1', '0'>
      ad  = <cid, p0, Ai, p0, w0, h>
      CKr = kdf_chain(RK4, S3^~t2)
  in
  [ R4(Rsp, cid, e0, Ai, w0, ~t2, S2, RK4), In(<'0x02', cid, h>) ]
  --[ Neq(S3, S2) ]->
  [ R4r(Rsp, cid, e0, Ai, w0, CKr, ad) ]

rule R_Read_m4:
  let p0 = 'g'^e0
  in
  [ R4r(Rsp, cid, e0, Ai, w0, CKr, ad), In(<'0x02', cid, h, aenc(m, ck_mk(CKr), ad)>) ]
  --[ RRecv(Rsp, cid, p0, Ai, w0, 'm4', m) ]->
  [ ]

#endif

#ifdef REVEAL

/* ---- The verified reveal (§19), -D=REVEAL ---- */

/* The OR-proof, as two constructors with no destructor: prf1 is the real
   branch, made with the key x of A = [x]p0 and of the register (g_S, [x]g_S);
   prf2 the other, made with the key of w0 = [y]p0. Each binds what §19.2's
   challenge does: cid, p0, A, w0, the name and the register. The reader
   checks one by equality, as the real check's equations hold exactly then,
   taking its key from a principal's: the real branch's from any principal's,
   the other from its own. A proof by a key no principal holds isn't here: it
   verifies only for registers of that key, so for no principal's Seedelf, and
   every lemma below is about a principal's (README). */
functions: prf1/8, prf2/8
restriction eq: "All x y #i. Eq(x, y)@i ==> x = y"

/* A Seedelf on chain: a name, once, with a register of its owner's key. The
   attacker mints its own, with any register, a copy of another's included. */
rule Seedelf:
  [ !Ltk(P, ~x), Fr(~s) ]
  --[ SeedelfOf(P, $N, 'g'^~s, ('g'^~s)^~x), OneName($N) ]->
  [ !Seedelf(P, $N, 'g'^~s, ('g'^~s)^~x), !Chain($N, 'g'^~s, ('g'^~s)^~x), Out(<$N, 'g'^~s, ('g'^~s)^~x>) ]

rule Seedelf_attacker:
  [ In(<gS, uS>) ] --[ OneName($N), AttackerSeedelf($N) ]-> [ !Chain($N, gS, uS) ]

restriction one_name: "All N #i #j. OneName(N)@i & OneName(N)@j ==> #i = #j"

/* The initiator reveals one of its Seedelfs in a conversation it started
   (§19.1): the name, the register, and the proof (§19.3). Sent in the
   clear, where the protocol sends it inside the ratchet: this attacker
   sees more than the real one. */
rule I_Reveal:
  [ !Conv(Ini, cid, rb, Ai, w0), !Ltk(Ini, ~xi), !Seedelf(Ini, N, gS, uS) ]
  --[ IRevealed(Ini, cid, N) ]->
  [ Out(<'reveal', cid, N, gS, uS, prf1(~xi, cid, 'g'^rb, Ai, w0, N, gS, uS)>) ]

/* The responder checks a reveal in a conversation it accepted, against the
   register the chain gives the name (§19.4). The real branch in two rules,
   A's key, then the register's: one rule raising both points to the key
   stalls Tamarin's precomputation, as a read deriving on several bases does. */
rule R_Check_reveal_own_key:
  let p0 = 'g'^e0 in
  [ !Accepted(Rsp, cid, e0, Ai, w0, rep), !Ltk(P, ~x), !Chain(N, gS, uS),
    In(<'reveal', cid, N, gS, uS, prf1(~x, cid, p0, Ai, w0, N, gS, uS)>) ]
  --[ Eq(p0^~x, Ai) ]->
  [ RevealOnA(Rsp, cid, N, gS, uS, ~x) ]

rule R_Check_reveal_own_key_register:
  [ RevealOnA(Rsp, cid, N, gS, uS, ~x) ]
  --[ Eq(gS^~x, uS), RVerified(Rsp, cid, N, gS, uS) ]->
  [ ]

rule R_Check_reveal_reader_key:
  let p0 = 'g'^e0 in
  [ !Accepted(Rsp, cid, e0, Ai, w0, rep), !Ltk(Rsp, ~xr), !Chain(N, gS, uS),
    In(<'reveal', cid, N, gS, uS, prf2(~xr, cid, p0, Ai, w0, N, gS, uS)>) ]
  --[ RVerified(Rsp, cid, N, gS, uS) ]->
  [ ]

/* §19.5: "Verified" names a Seedelf only if its owner revealed it, in this
   conversation, which it started with this reader; unless the owner's key
   or the reader's was stolen first. The register is any of a principal's
   Seedelfs, and the name any name, so a name the attacker minted with a
   copy of the register is covered too. */
lemma reveal_only_from_the_seedelfs_owner:
  "All R cid N N0 gS uS P #i #k.
     RVerified(R, cid, N, gS, uS)@i & SeedelfOf(P, N0, gS, uS)@k
     ==> (Ex p0 Ai w0 F #s #v. IStart(P, R, cid, p0, Ai, w0, F)@s & IRevealed(P, cid, N)@v & #v < #i)
       | (Ex #r. RevLtk(P)@r & #r < #i) | (Ex #r. RevLtk(R)@r & #r < #i)"

/* Reachable, and the reader's own key forges one (§19.5): the attacker
   writes to the reader as itself and shows another's Seedelf. */
lemma reveal_verifies: exists-trace
  "Ex Ini Rsp cid p0 Ai w0 F N gS uS #s #a #v #k.
     IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & RAccept(Rsp, cid, p0, Ai, w0, F)@a
   & IRevealed(Ini, cid, N)@v & RVerified(Rsp, cid, N, gS, uS)@k
   & not (Ex P #r. RevLtk(P)@r)"

lemma reader_key_forges_a_reveal: exists-trace
  "Ex Rsp cid p0 Ai w0 F N gS uS P #a #o #r #k.
     RAccept(Rsp, cid, p0, Ai, w0, F)@a & SeedelfOf(P, N, gS, uS)@o & RevLtk(Rsp)@r
   & RVerified(Rsp, cid, N, gS, uS)@k & not (P = Rsp)
   & not (Ex I R2 c2 p2 A2 w2 F2 #s. IStart(I, R2, c2, p2, A2, w2, F2)@s)
   & not (Ex c M #v. IRevealed(P, c, M)@v) & not (Ex #q. RevLtk(P)@q)"

#endif

#ifdef SKIPPED

/* ---- Skipped keys (§4.1, §6), -D=SKIPPED ---- */

/* The sessions up to the first reply, then the initiator's next chain with
   two messages, n = 0 and n = 1, which the reader takes in either order:
   n = 1 first keeps n = 0's key until n = 0 comes, and that kept key can be
   stolen, once (§1.1's "one message key"). No later step, no state theft. */
rule I_Send_m3_first:
  let p0 = 'g'^~rb
      S2 = p0^~s2
      h  = <S2, '1', '0'>
      ad = <cid, p0, Ai, p0, w0, h>
  in
  [ I2(Ini, Rsp, cid, ~rb, Ai, w0, ~s2, T1, RK, CKs), Fr(~m3) ]
  --[ ISent(Ini, Rsp, cid, 'm3', ~m3) ]->
  [ I2b(Ini, Rsp, cid, ~rb, Ai, w0, ~s2, ck_next(CKs)),
    Out(<'0x02', cid, h, aenc(~m3, ck_mk(CKs), ad)>) ]

rule I_Send_m3_second:
  let p0 = 'g'^~rb
      S2 = p0^~s2
      h  = <S2, '1', '1'>
      ad = <cid, p0, Ai, p0, w0, h>
  in
  [ I2b(Ini, Rsp, cid, ~rb, Ai, w0, ~s2, CK), Fr(~m3b) ]
  --[ ISent(Ini, Rsp, cid, 'm3b', ~m3b) ]->
  [ Out(<'0x02', cid, h, aenc(~m3b, ck_mk(CK), ad)>) ]

/* The reader derives the chain from whichever comes first. */
rule R_Derive_m3_chain:
  let CKr = kdf_chain(RK2, S2^~t1)
  in
  [ R2(Rsp, cid, e0, Ai, w0, ~t1, Si, RK2), In(<'0x02', cid, <S2, '1', n>>) ]
  --[ Neq(S2, Si) ]->
  [ R2c(Rsp, cid, e0, Ai, w0, S2, CKr) ]

rule R_Read_m3_in_order:
  let p0 = 'g'^e0
      ad = <cid, p0, Ai, p0, w0, <S2, '1', '0'>>
  in
  [ R2c(Rsp, cid, e0, Ai, w0, S2, CKr), In(<'0x02', cid, <S2, '1', '0'>, aenc(m, ck_mk(CKr), ad)>) ]
  --[ RRecv(Rsp, cid, p0, Ai, w0, 'm3', m) ]->
  [ R2n(Rsp, cid, e0, Ai, w0, S2, ck_next(CKr)) ]

rule R_Read_m3b_next:
  let p0 = 'g'^e0
      ad = <cid, p0, Ai, p0, w0, <S2, '1', '1'>>
  in
  [ R2n(Rsp, cid, e0, Ai, w0, S2, CK), In(<'0x02', cid, <S2, '1', '1'>, aenc(m, ck_mk(CK), ad)>) ]
  --[ RRecv(Rsp, cid, p0, Ai, w0, 'm3b', m) ]->
  [ ]

rule R_Read_m3b_skipping:
  let p0 = 'g'^e0
      ad = <cid, p0, Ai, p0, w0, <S2, '1', '1'>>
  in
  [ R2c(Rsp, cid, e0, Ai, w0, S2, CKr), In(<'0x02', cid, <S2, '1', '1'>, aenc(m, ck_mk(ck_next(CKr)), ad)>) ]
  --[ RRecv(Rsp, cid, p0, Ai, w0, 'm3b', m), RSkipped(Rsp, cid) ]->
  [ Skipped(Rsp, cid, e0, Ai, w0, S2, ck_mk(CKr)), SkippedCopy(Rsp, cid, ck_mk(CKr)) ]

rule R_Read_m3_with_the_skipped_key:
  let p0 = 'g'^e0
      ad = <cid, p0, Ai, p0, w0, <S2, '1', '0'>>
  in
  [ Skipped(Rsp, cid, e0, Ai, w0, S2, mk), In(<'0x02', cid, <S2, '1', '0'>, aenc(m, mk, ad)>) ]
  --[ RRecv(Rsp, cid, p0, Ai, w0, 'm3', m), RUsedSkipped(Rsp, cid) ]->
  [ ]

rule Reveal_skipped_key:
  [ SkippedCopy(Rsp, cid, mk) ] --[ RevMk(Rsp, cid) ]-> [ Out(mk) ]

/* Its own copies of the sessions' helpers: each configuration proves its own. */

lemma skipped_keys1_secret [reuse]:
  "(All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k1', rk, ck)@i & KU(rk)@j
       ==> (Ex #r. RevLtk(Rsp)@r))
 & (All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k1', rk, ck)@i & KU(ck)@j
       ==> (Ex #r. RevLtk(Rsp)@r))"

lemma skipped_keys2_secret [reuse, hide_lemma=skipped_keys1_secret]:
  "(All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k2', rk, ck)@i & KU(rk)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i))
 & (All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k2', rk, ck)@i & KU(ck)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i))"

lemma skipped_keys3_secret [reuse]:
  "(All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k3', rk, ck)@i & KU(rk)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i))
 & (All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k3', rk, ck)@i & KU(ck)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i))"

lemma skipped_static_dh_secret [reuse, hide_lemma=skipped_keys1_secret, hide_lemma=skipped_keys2_secret,
                                hide_lemma=skipped_keys3_secret]:
  "All R p0 A s P #i #k #j.
     RStatic(R, p0, A, s)@i & KeyOn(P, p0, A)@k & KU(s)@j
     ==> (Ex #r. RevLtk(P)@r & #r < #j) | (Ex #r. RevLtk(R)@r & #r < #j)"

lemma skipped_static_dh_holds_r_a [reuse, hide_lemma=skipped_keys1_secret, hide_lemma=skipped_keys2_secret,
                                   hide_lemma=skipped_keys3_secret]:
  "All Rsp cid p0 Ai w0 F P #i #k.
     RAccept(Rsp, cid, p0, Ai, w0, F)@i & KeyOn(P, p0, Ai)@k
     ==> (Ex #s. IStart(P, Rsp, cid, p0, Ai, w0, F)@s & #s < #i)
       | (Ex #r. RevLtk(P)@r & #r < #i) | (Ex #r. RevLtk(Rsp)@r & #r < #i)"

/* §1.1: the kept key opens its own message, and only that: the next one on
   its chain stays secret. */

lemma skipped_key_opens_only_its_message [hide_lemma=skipped_keys1_secret,
                                          hide_lemma=skipped_keys2_secret,
                                          hide_lemma=skipped_static_dh_secret,
                                          hide_lemma=skipped_static_dh_holds_r_a]:
  "(All Ini Rsp cid m #i #j. ISent(Ini, Rsp, cid, 'm3b', m)@i & K(m)@j
       ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g))
 & (All Ini Rsp cid m #i #j. ISent(Ini, Rsp, cid, 'm3', m)@i & K(m)@j
       ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g) | (Ex #r. RevMk(Rsp, cid)@r))"

/* Agreement on both, in either order. Here the kept key alone writes
   nothing, as the tag's associated data holds w0; with w0 too, which the
   reader's own key gives even stolen after it accepted, it writes the
   message it stands for while the reader waits. On the wire the first half
   rests on the outer layer, which this model leaves out (README,
   assumption 2): the envelope's [o]w0, with o from the key and the inner
   salt, gives w0, and AES-GCM's tag can be redone without the associated
   data from one genuine ciphertext and its key. */

/* Its 2.2 GB peak is where GHC would start compacting, which crawls (README). */
// check.sh: CAP=8g,RTS=-c100
lemma skipped_agreement [hide_lemma=skipped_keys1_secret, hide_lemma=skipped_keys2_secret,
                         hide_lemma=skipped_keys3_secret]:
  "(All Rsp cid p0 Ai w0 m P #i #k.
       RRecv(Rsp, cid, p0, Ai, w0, 'm3b', m)@i & KeyOn(P, p0, Ai)@k
       ==> (Ex F #s #t. IStart(P, Rsp, cid, p0, Ai, w0, F)@s & ISent(P, Rsp, cid, 'm3b', m)@t & #t < #i)
         | (Ex F #a #r. RAccept(Rsp, cid, p0, Ai, w0, F)@a & RevLtk(P)@r & #r < #a)
         | (Ex F #a #r. RAccept(Rsp, cid, p0, Ai, w0, F)@a & RevLtk(Rsp)@r & #r < #a))
 & (All Rsp cid p0 Ai w0 m P #i #k.
       RRecv(Rsp, cid, p0, Ai, w0, 'm3', m)@i & KeyOn(P, p0, Ai)@k
       ==> (Ex F #s #t. IStart(P, Rsp, cid, p0, Ai, w0, F)@s & ISent(P, Rsp, cid, 'm3', m)@t & #t < #i)
         | (Ex F #a #r. RAccept(Rsp, cid, p0, Ai, w0, F)@a & RevLtk(P)@r & #r < #a)
         | (Ex F #a #r. RAccept(Rsp, cid, p0, Ai, w0, F)@a & RevLtk(Rsp)@r & #r < #a)
         | (Ex #r #q. RevMk(Rsp, cid)@r & RevLtk(Rsp)@q & #r < #i & #q < #i))"

/* Each is read once: a kept key goes when it's used. */

lemma skipped_each_read_once:
  "All Rsp cid p0 Ai w0 n m m2 #i #j.
     RRecv(Rsp, cid, p0, Ai, w0, n, m)@i & RRecv(Rsp, cid, p0, Ai, w0, n, m2)@j
     ==> #i = #j"

/* Reachable: both read out of order; the kept key, stolen, opens its
   message; and with the reader's key stolen after it accepted, writes it. */

lemma skipped_in_order: exists-trace
  "Ex Ini Rsp cid p0 Ai w0 F m m2 #s #k #t #u #c #a.
     IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & KeyOn(Ini, p0, Ai)@k & ISent(Ini, Rsp, cid, 'm3', m)@t
   & ISent(Ini, Rsp, cid, 'm3b', m2)@u
   & RRecv(Rsp, cid, p0, Ai, w0, 'm3', m)@c & RRecv(Rsp, cid, p0, Ai, w0, 'm3b', m2)@a & #c < #a
   & not (Ex R c2 #k. RSkipped(R, c2)@k)
   & not (Ex P #r. RevLtk(P)@r) & not (Ex R c2 #r. RevMk(R, c2)@r)"

lemma skipped_out_of_order: exists-trace
  "Ex Ini Rsp cid p0 Ai w0 F m m2 #s #t #u #a #b #c #d.
     IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & ISent(Ini, Rsp, cid, 'm3', m)@t
   & ISent(Ini, Rsp, cid, 'm3b', m2)@u
   & RRecv(Rsp, cid, p0, Ai, w0, 'm3b', m2)@a & RSkipped(Rsp, cid)@b
   & RRecv(Rsp, cid, p0, Ai, w0, 'm3', m)@c & RUsedSkipped(Rsp, cid)@d
   & not (Ex P #r. RevLtk(P)@r) & not (Ex R c #r. RevMk(R, c)@r)"

lemma skipped_key_stolen_opens_its_message: exists-trace
  "Ex Ini Rsp cid p0 Ai w0 F m m2 #s #t #u #a #k #j.
     IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & ISent(Ini, Rsp, cid, 'm3', m)@t
   & ISent(Ini, Rsp, cid, 'm3b', m2)@u & RRecv(Rsp, cid, p0, Ai, w0, 'm3b', m2)@a
   & RevMk(Rsp, cid)@k & K(m)@j & not (Ex P #r. RevLtk(P)@r)"

lemma skipped_key_and_reader_key_forge_its_message: exists-trace
  "Ex Ini Rsp cid p0 Ai w0 F m2 m #s #u #a #b #q #k #c.
     IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & RAccept(Rsp, cid, p0, Ai, w0, F)@a
   & ISent(Ini, Rsp, cid, 'm3b', m2)@u & RRecv(Rsp, cid, p0, Ai, w0, 'm3b', m2)@b
   & RevLtk(Rsp)@q & #a < #q & RevMk(Rsp, cid)@k & RRecv(Rsp, cid, p0, Ai, w0, 'm3', m)@c
   & not (Ex #t. ISent(Ini, Rsp, cid, 'm3', m)@t) & not (Ex #r. RevLtk(Ini)@r)"

#endif

/* ---- A ranking, for any configuration ---- */

/* For the lemmas that stalled under Tamarin's default ranking (README):
   solve the protocol's states first, so a [reuse] lemma has the rule
   instances it matches; then the attacker's knowledge of fresh values and
   of keys; DH case splits late, and how the attacker built a message last. */
tactic: states_then_keys
presort: s
prio:
    regex "▶"
prio:
    regex "!KU\( ~"
prio:
    regex "!KU\( ck_mk" | regex "!KU\( kdf_"
deprio:
    regex "splitEqs"
deprio:
    regex "!KU\( aenc" | regex "!KU\( <'0x0"

/* ---- Lemmas: the replay check (-D=NO_CID_RULE) ---- */

#ifdef NO_CID_RULE

lemma first_message_replays_without_the_cid_rule: exists-trace
  "Ex Rsp cid p0 Ai w0 m #i #j.
     RRecv(Rsp, cid, p0, Ai, w0, 'm1', m)@i & RRecv(Rsp, cid, p0, Ai, w0, 'm1', m)@j & not (#i = #j)
   & not (Ex P #n. RevLtk(P)@n)"

#endif

/* ---- Lemmas: sessions (no flag) ---- */

/* Long-term keys and the initiator's state can be stolen. A lemma names
   the initiator's state where the state opens something, and also where
   it doesn't but naming it lets Tamarin finish (README); it then still
   says everything about traces where no state is stolen. */

/* A keys lemma guards on the key itself, KU(rk) and KU(ck), so a later proof
   that reaches the key closes there. K(k) wouldn't: in a lemma, K is the
   attacker sending a message into the protocol, and a key is never sent.
   Nor would KU(k) with k = rk or ck: it meets every term the attacker
   derives, and the equality splits the search on each (README).
   An all-traces lemma sees only the [reuse] lemmas its proof rests on, by
   hide_lemma, so the rest cost it nothing; hiding one only drops an
   assumption. A trace lemma sees them all: they cut every branch where the
   attacker would build a message without its key. Each trace lemma names
   its trace step by step, which only narrows what it says exists. */

#ifdef not CONTINUATIONS & not NO_CID_RULE & not RESPONDER_STATE & not REVEAL & not SKIPPED

/* Each step's root key and chain key, one step at a time, each reused by
   the next. */

lemma keys1_secret [reuse]:
  "(All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k1', rk, ck)@i & KU(rk)@j
       ==> (Ex #r. RevLtk(Rsp)@r))
 & (All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k1', rk, ck)@i & KU(ck)@j
       ==> (Ex #r. RevLtk(Rsp)@r))"

lemma keys2_secret [reuse, hide_lemma=keys1_secret]:
  "(All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k2', rk, ck)@i & KU(rk)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i))
 & (All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k2', rk, ck)@i & KU(ck)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i))"

lemma keys3_secret [reuse]:
  "(All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k3', rk, ck)@i & KU(rk)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i) | (Ex #r. RevState(Ini, cid)@r))
 & (All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k3', rk, ck)@i & KU(ck)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i) | (Ex #r. RevState(Ini, cid)@r))"

/* keys4 is proved in the KU(k) form, which Tamarin finishes in minutes here
   and the key-guarded one didn't in two hours; its twin below restates it,
   guarded on each key, and is all the later lemmas see. */
lemma keys4_secret [reuse, hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                    hide_lemma=keys3_secret]:
  "All Ini Rsp cid rk ck k #i #j.
     IKeys(Ini, Rsp, cid, 'k4', rk, ck)@i & KU(k)@j & ((k = rk) | (k = ck))
     ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g) | (Ex #r. RevState(Ini, cid)@r)"

lemma keys4_secret_guarded [reuse, hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                            hide_lemma=keys3_secret]:
  "(All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k4', rk, ck)@i & KU(rk)@j
       ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g) | (Ex #r. RevState(Ini, cid)@r))
 & (All Ini Rsp cid rk ck #i #j.
       IKeys(Ini, Rsp, cid, 'k4', rk, ck)@i & KU(ck)@j
       ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g) | (Ex #r. RevState(Ini, cid)@r))"

lemma heal_keys_secret [reuse, heuristic={states_then_keys}, hide_lemma=keys1_secret,
                        hide_lemma=keys2_secret, hide_lemma=keys3_secret,
                        hide_lemma=keys4_secret, hide_lemma=keys4_secret_guarded]:
  "(All Ini Rsp cid T2 rk ck #i #b #j.
       IHeal(Ini, Rsp, cid, T2, rk, ck)@i & RSentKey(Rsp, cid, 'r2', T2)@b
       & KU(rk)@j
       ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g))
 & (All Ini Rsp cid T2 rk ck #i #b #j.
       IHeal(Ini, Rsp, cid, T2, rk, ck)@i & RSentKey(Rsp, cid, 'r2', T2)@b
       & KU(ck)@j
       ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g))"

/* Its state excuse is dated, as m4's agreement needs: Tamarin takes an hour
   and a half and 6.5 GB of live heap on it, so check.sh gives it its own room. */
// check.sh: CAP=20g,LIMIT=9000,RTS=-c100
lemma responder_keys2_secret [reuse, hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                              hide_lemma=keys3_secret, hide_lemma=keys4_secret,
                              hide_lemma=heal_keys_secret, hide_lemma=keys4_secret_guarded]:
  "(All Ini Rsp cid p0 Ai w0 F rk ck #i #s #j.
       RKeys(Rsp, cid, 'k2', rk, ck)@i & RAccept(Rsp, cid, p0, Ai, w0, F)@i
       & IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & KU(rk)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i) | (Ex #r. RevState(Ini, cid)@r & #r < #j))
 & (All Ini Rsp cid p0 Ai w0 F rk ck #i #s #j.
       RKeys(Rsp, cid, 'k2', rk, ck)@i & RAccept(Rsp, cid, p0, Ai, w0, F)@i
       & IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & KU(ck)@j
       ==> (Ex #r. RevLtk(Rsp)@r & #r < #i) | (Ex #r. RevState(Ini, cid)@r & #r < #j))"

lemma responder_keys4_secret [reuse, heuristic={states_then_keys}, hide_lemma=keys1_secret,
                              hide_lemma=keys2_secret, hide_lemma=keys3_secret,
                              hide_lemma=keys4_secret, hide_lemma=heal_keys_secret,
                              hide_lemma=keys4_secret_guarded]:
  "(All Ini Rsp cid p0 Ai w0 F S2 rk ck #i #a #s #j.
       RHeal(Rsp, cid, S2, rk, ck)@i & RAccept(Rsp, cid, p0, Ai, w0, F)@a
       & IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & KU(rk)@j
       ==> (Ex #r #a. RevLtk(Rsp)@r & RAccept(Rsp, cid, p0, Ai, w0, F)@a & #r < #a) | (Ex #r. RevState(Ini, cid)@r & #r < #j))
 & (All Ini Rsp cid p0 Ai w0 F S2 rk ck #i #a #s #j.
       RHeal(Rsp, cid, S2, rk, ck)@i & RAccept(Rsp, cid, p0, Ai, w0, F)@a
       & IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & KU(ck)@j
       ==> (Ex #r #a. RevLtk(Rsp)@r & RAccept(Rsp, cid, p0, Ai, w0, F)@a & #r < #a) | (Ex #r. RevState(Ini, cid)@r & #r < #j))"

/* Agreement on cid, R_A, R_B and every message, both ways. A key stolen
   once the session runs can't forge into it: only a theft before the
   reader's first step excuses a later message, or a stolen state, which
   §1.1 says lets the attacker step in. */

lemma initiator_agreement_r1 [reuse, hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                              hide_lemma=keys3_secret, hide_lemma=keys4_secret,
                              hide_lemma=heal_keys_secret, hide_lemma=responder_keys2_secret,
                              hide_lemma=responder_keys4_secret,
                              hide_lemma=keys4_secret_guarded]:
  "All Ini Rsp cid p0 Ai w0 m #i.
     IRecv(Ini, Rsp, cid, p0, Ai, w0, 'r1', m)@i
     ==> (Ex #s. RSent(Rsp, cid, p0, Ai, w0, 'r1', m)@s & #s < #i)
       | (Ex #r. RevLtk(Rsp)@r & #r < #i)"

lemma initiator_agreement_r2 [reuse, hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                              hide_lemma=keys3_secret, hide_lemma=keys4_secret,
                              hide_lemma=heal_keys_secret, hide_lemma=responder_keys2_secret,
                              hide_lemma=responder_keys4_secret,
                              hide_lemma=initiator_agreement_r1,
                              hide_lemma=keys4_secret_guarded]:
  "All Ini Rsp cid p0 Ai w0 m #i.
     IRecv(Ini, Rsp, cid, p0, Ai, w0, 'r2', m)@i
     ==> (Ex #s. RSent(Rsp, cid, p0, Ai, w0, 'r2', m)@s & #s < #i)
       | (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g) | (Ex #r. RevState(Ini, cid)@r & #r < #i)"

/* §3: who controls R_A. First the static DH itself: [x_R]A for A of P's key
   is secret unless one of the two keys was stolen before it was known. Then a
   reader accepts a session whose A is P's key only if P started it with
   exactly that cid, R_A, R_B and F. Both are reused by the responder's
   agreement below. */

lemma static_dh_secret [reuse, hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                        hide_lemma=keys3_secret, hide_lemma=keys4_secret,
                        hide_lemma=heal_keys_secret, hide_lemma=responder_keys2_secret,
                        hide_lemma=responder_keys4_secret, hide_lemma=initiator_agreement_r1,
                        hide_lemma=initiator_agreement_r2, hide_lemma=keys4_secret_guarded]:
  "All R p0 A s P #i #k #j.
     RStatic(R, p0, A, s)@i & KeyOn(P, p0, A)@k & KU(s)@j
     ==> (Ex #r. RevLtk(P)@r & #r < #j) | (Ex #r. RevLtk(R)@r & #r < #j)"

lemma static_dh_holds_r_a [reuse, hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                           hide_lemma=keys3_secret, hide_lemma=keys4_secret,
                           hide_lemma=heal_keys_secret, hide_lemma=responder_keys2_secret,
                           hide_lemma=responder_keys4_secret,
                           hide_lemma=initiator_agreement_r1,
                           hide_lemma=initiator_agreement_r2,
                           hide_lemma=keys4_secret_guarded]:
  "All Rsp cid p0 Ai w0 F P #i #k.
     RAccept(Rsp, cid, p0, Ai, w0, F)@i & KeyOn(P, p0, Ai)@k
     ==> (Ex #s. IStart(P, Rsp, cid, p0, Ai, w0, F)@s & #s < #i)
       | (Ex #r. RevLtk(P)@r & #r < #i) | (Ex #r. RevLtk(Rsp)@r & #r < #i)"

lemma responder_agreement_m1 [hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                              hide_lemma=keys3_secret, hide_lemma=keys4_secret,
                              hide_lemma=heal_keys_secret, hide_lemma=responder_keys2_secret,
                              hide_lemma=responder_keys4_secret,
                              hide_lemma=initiator_agreement_r1,
                              hide_lemma=initiator_agreement_r2,
                              hide_lemma=keys4_secret_guarded]:
  "All Rsp cid p0 Ai w0 m P #i #k.
     RRecv(Rsp, cid, p0, Ai, w0, 'm1', m)@i & KeyOn(P, p0, Ai)@k
     ==> (Ex F #s #t. IStart(P, Rsp, cid, p0, Ai, w0, F)@s & ISent(P, Rsp, cid, 'm1', m)@t & #t < #i)
       | (Ex #r. RevLtk(P)@r & #r < #i) | (Ex #r. RevLtk(Rsp)@r & #r < #i)"

lemma responder_agreement_m3 [hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                              hide_lemma=keys3_secret, hide_lemma=keys4_secret,
                              hide_lemma=heal_keys_secret, hide_lemma=responder_keys4_secret,
                              hide_lemma=initiator_agreement_r1,
                              hide_lemma=initiator_agreement_r2,
                              hide_lemma=responder_keys2_secret,
                              hide_lemma=keys4_secret_guarded]:
  "All Rsp cid p0 Ai w0 m P #i #k.
     RRecv(Rsp, cid, p0, Ai, w0, 'm3', m)@i & KeyOn(P, p0, Ai)@k
     ==> (Ex F #s #t. IStart(P, Rsp, cid, p0, Ai, w0, F)@s & ISent(P, Rsp, cid, 'm3', m)@t & #t < #i)
       | (Ex F #a #r. RAccept(Rsp, cid, p0, Ai, w0, F)@a & RevLtk(P)@r & #r < #a)
       | (Ex F #a #r. RAccept(Rsp, cid, p0, Ai, w0, F)@a & RevLtk(Rsp)@r & #r < #a)
       | (Ex #r. RevState(P, cid)@r & #r < #i)"

lemma responder_agreement_m4 [hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                              hide_lemma=keys3_secret, hide_lemma=keys4_secret,
                              hide_lemma=heal_keys_secret, hide_lemma=responder_keys2_secret,
                              hide_lemma=initiator_agreement_r1,
                              hide_lemma=initiator_agreement_r2,
                              hide_lemma=keys4_secret_guarded]:
  "All Rsp cid p0 Ai w0 m P #i #k.
     RRecv(Rsp, cid, p0, Ai, w0, 'm4', m)@i & KeyOn(P, p0, Ai)@k
     ==> (Ex F #s #t. IStart(P, Rsp, cid, p0, Ai, w0, F)@s & ISent(P, Rsp, cid, 'm4', m)@t & #t < #i)
       | (Ex F #a #r. RAccept(Rsp, cid, p0, Ai, w0, F)@a & RevLtk(P)@r & #r < #a)
       | (Ex F #a #r. RAccept(Rsp, cid, p0, Ai, w0, F)@a & RevLtk(Rsp)@r & #r < #a)
       | (Ex #r. RevState(P, cid)@r & #r < #i)"

/* §1.1: what each theft reveals of content. */

lemma m1_secret [hide_lemma=keys4_secret]:
  "All Ini Rsp cid m #i #j. ISent(Ini, Rsp, cid, 'm1', m)@i & K(m)@j
     ==> (Ex #k. RevLtk(Rsp)@k)"

lemma m3_forward_secret [hide_lemma=keys1_secret, hide_lemma=keys2_secret,
                         hide_lemma=keys4_secret, hide_lemma=heal_keys_secret,
                         hide_lemma=responder_keys2_secret,
                         hide_lemma=responder_keys4_secret,
                         hide_lemma=initiator_agreement_r1,
                         hide_lemma=initiator_agreement_r2, hide_lemma=static_dh_secret,
                         hide_lemma=static_dh_holds_r_a, hide_lemma=keys4_secret_guarded]:
  "All Ini Rsp cid m #i #j. ISent(Ini, Rsp, cid, 'm3', m)@i & K(m)@j
     ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g) | (Ex #r. RevState(Ini, cid)@r)"

lemma m4_forward_secret [heuristic={states_then_keys}, hide_lemma=keys1_secret,
                         hide_lemma=keys2_secret, hide_lemma=keys3_secret,
                         hide_lemma=heal_keys_secret, hide_lemma=responder_keys2_secret,
                         hide_lemma=responder_keys4_secret,
                         hide_lemma=initiator_agreement_r1,
                         hide_lemma=initiator_agreement_r2, hide_lemma=static_dh_secret,
                         hide_lemma=static_dh_holds_r_a, hide_lemma=keys4_secret]:
  "All Ini Rsp cid m #i #j. ISent(Ini, Rsp, cid, 'm4', m)@i & K(m)@j
     ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g) | (Ex #r. RevState(Ini, cid)@r)"

lemma m4_heals_after_a_reply_the_attacker_only_watched [heuristic={states_then_keys},
                                                        hide_lemma=keys1_secret,
                                                        hide_lemma=keys2_secret,
                                                        hide_lemma=keys3_secret,
                                                        hide_lemma=keys4_secret,
                                                        hide_lemma=responder_keys2_secret,
                                                        hide_lemma=responder_keys4_secret,
                                                        hide_lemma=initiator_agreement_r1,
                                                        hide_lemma=initiator_agreement_r2,
                                                        hide_lemma=static_dh_secret,
                                                        hide_lemma=static_dh_holds_r_a,
                                                        hide_lemma=keys4_secret_guarded]:
  "All Ini Rsp cid T2 m #i #a #b #j.
     ISent(Ini, Rsp, cid, 'm4', m)@i & IRecvKey(Ini, cid, 'r2', T2)@a & RSentKey(Rsp, cid, 'r2', T2)@b
   & K(m)@j
     ==> (Ex #r #g. RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g)"

/* §1.1, x_B's row: "anything Alice sent after receiving Bob's first reply"
   stays secret even when x_B was stolen before that reply, so long as the
   reply was Bob's own and the attacker only watched: keyed on the reply's
   ratchet key, as the healing lemmas are. Only her state opens m3 then. */
lemma m3_secret_after_a_genuine_reply [heuristic={states_then_keys}, hide_lemma=keys1_secret,
                                       hide_lemma=keys2_secret, hide_lemma=keys4_secret,
                                       hide_lemma=heal_keys_secret,
                                       hide_lemma=responder_keys2_secret,
                                       hide_lemma=responder_keys4_secret,
                                       hide_lemma=initiator_agreement_r1,
                                       hide_lemma=initiator_agreement_r2,
                                       hide_lemma=static_dh_secret,
                                       hide_lemma=static_dh_holds_r_a,
                                       hide_lemma=keys4_secret_guarded]:
  "All Ini Rsp cid T1 m #i #a #b #j.
     ISent(Ini, Rsp, cid, 'm3', m)@i & IRecvKey(Ini, cid, 'r1', T1)@a & RSentKey(Rsp, cid, 'r1', T1)@b
   & K(m)@j
     ==> (Ex #r. RevState(Ini, cid)@r)"

/* The responder's accepted F is the initiator's own, unless the responder's
   key was stolen before it accepted, or the initiator's state: only then can
   another F carry her cid, p0, A and w0. r1's and r2's keys lemmas name her F. */

lemma responder_accepted_the_initiators_f [reuse, hide_lemma=keys1_secret,
                                           hide_lemma=keys2_secret, hide_lemma=keys3_secret,
                                           hide_lemma=keys4_secret,
                                           hide_lemma=heal_keys_secret,
                                           hide_lemma=responder_keys2_secret,
                                           hide_lemma=responder_keys4_secret,
                                           hide_lemma=initiator_agreement_r1,
                                           hide_lemma=initiator_agreement_r2,
                                           hide_lemma=static_dh_secret,
                                           hide_lemma=static_dh_holds_r_a,
                                           hide_lemma=keys4_secret_guarded]:
  "All Ini Rsp cid p0 Ai w0 F F2 #i #s.
     RAccept(Rsp, cid, p0, Ai, w0, F2)@i & IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s
     ==> (F2 = F) | (Ex #r. RevLtk(Rsp)@r & #r < #i) | (Ex #r. RevState(Ini, cid)@r)"

lemma r1_forward_secret [heuristic={states_then_keys}, hide_lemma=keys1_secret,
                         hide_lemma=keys2_secret, hide_lemma=keys3_secret,
                         hide_lemma=keys4_secret, hide_lemma=heal_keys_secret,
                         hide_lemma=responder_keys4_secret,
                         hide_lemma=initiator_agreement_r1,
                         hide_lemma=initiator_agreement_r2, hide_lemma=static_dh_secret,
                         hide_lemma=static_dh_holds_r_a, hide_lemma=keys4_secret_guarded]:
  "All Ini Rsp cid p0 Ai w0 F m #i #s #j.
     RSent(Rsp, cid, p0, Ai, w0, 'r1', m)@i & IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & K(m)@j
     ==> (Ex F2 #r #a. RevLtk(Rsp)@r & RAccept(Rsp, cid, p0, Ai, w0, F2)@a & #r < #a) | (Ex #r. RevState(Ini, cid)@r)"

lemma r2_forward_secret [heuristic={states_then_keys}, hide_lemma=keys1_secret,
                         hide_lemma=keys2_secret, hide_lemma=keys3_secret,
                         hide_lemma=keys4_secret, hide_lemma=heal_keys_secret,
                         hide_lemma=responder_keys2_secret,
                         hide_lemma=initiator_agreement_r1,
                         hide_lemma=initiator_agreement_r2, hide_lemma=static_dh_secret,
                         hide_lemma=static_dh_holds_r_a, hide_lemma=keys4_secret_guarded]:
  "All Ini Rsp cid p0 Ai w0 F m #i #s #j.
     RSent(Rsp, cid, p0, Ai, w0, 'r2', m)@i & IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & K(m)@j
     ==> (Ex F2 #r #a. RevLtk(Rsp)@r & RAccept(Rsp, cid, p0, Ai, w0, F2)@a & #r < #a) | (Ex #r. RevState(Ini, cid)@r)"

/* Traces the model must be able to reach: not vacuous, and the limits
   §1.1 states are real. */

lemma executable [hide_lemma=keys4_secret]: exists-trace
  "Ex Ini Rsp cid p0 Ai w0 F m1 r1 m3 r2 m #s #k #t #a #b #c #d #e #f #g #i #j.
     IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & KeyOn(Ini, p0, Ai)@k & ISent(Ini, Rsp, cid, 'm1', m1)@t
   & RRecv(Rsp, cid, p0, Ai, w0, 'm1', m1)@a & RSent(Rsp, cid, p0, Ai, w0, 'r1', r1)@b
   & IRecv(Ini, Rsp, cid, p0, Ai, w0, 'r1', r1)@c & ISent(Ini, Rsp, cid, 'm3', m3)@d
   & RRecv(Rsp, cid, p0, Ai, w0, 'm3', m3)@e & RSent(Rsp, cid, p0, Ai, w0, 'r2', r2)@f
   & IRecv(Ini, Rsp, cid, p0, Ai, w0, 'r2', r2)@g & ISent(Ini, Rsp, cid, 'm4', m)@i
   & RRecv(Rsp, cid, p0, Ai, w0, 'm4', m)@j
   & not (Ex P #k. RevLtk(P)@k) & not (Ex P c #k. RevState(P, c)@k)"

lemma m1_open_to_a_later_reader_key [hide_lemma=keys4_secret]: exists-trace
  "Ex Ini Rsp cid m #i #g #k #l.
     ISent(Ini, Rsp, cid, 'm1', m)@i & IGotReply(Ini, Rsp, cid)@g & RevLtk(Rsp)@k & #g < #k & K(m)@l
   & not (Ex P #n. RevLtk(P)@n & #n < #g) & not (Ex P c #n. RevState(P, c)@n)"

lemma initiator_state_opens_m3_and_r2 [hide_lemma=keys4_secret]: exists-trace
  "Ex Ini Rsp cid p0 Ai w0 F m1 r1 m r #s0 #t #a #b #c #i #e #s #k #j #l.
     IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s0 & ISent(Ini, Rsp, cid, 'm1', m1)@t
   & RRecv(Rsp, cid, p0, Ai, w0, 'm1', m1)@a & RSent(Rsp, cid, p0, Ai, w0, 'r1', r1)@b
   & IRecv(Ini, Rsp, cid, p0, Ai, w0, 'r1', r1)@c & ISent(Ini, Rsp, cid, 'm3', m)@i
   & RRecv(Rsp, cid, p0, Ai, w0, 'm3', m)@e & RSent(Rsp, cid, p0, Ai, w0, 'r2', r)@s
   & RevState(Ini, cid)@k & K(m)@j & K(r)@l & not (Ex P #n. RevLtk(P)@n)"

lemma reader_key_before_the_reply_takes_over [hide_lemma=keys4_secret]: exists-trace
  "Ex Ini Rsp cid m #i #r #g #j.
     ISent(Ini, Rsp, cid, 'm3', m)@i & RevLtk(Rsp)@r & IGotReply(Ini, Rsp, cid)@g & #r < #g & K(m)@j
   & not (Ex p0 Ai w0 r #b. RSent(Rsp, cid, p0, Ai, w0, 'r1', r)@b)
   & not (Ex #n. RevLtk(Ini)@n) & not (Ex P c #n. RevState(P, c)@n)"

lemma reader_key_lets_anyone_pose_to_the_reader [hide_lemma=keys4_secret]: exists-trace
  "Ex Rsp cid p0 Ai w0 F P #i #k #r.
     RAccept(Rsp, cid, p0, Ai, w0, F)@i & KeyOn(P, p0, Ai)@k & RevLtk(Rsp)@r & #r < #i & not (P = Rsp)
   & not (Ex I R2 c2 A2 w2 F2 #s. IStart(I, R2, c2, p0, A2, w2, F2)@s)
   & not (Ex I R2 p2 A2 w2 F2 #s. IStart(I, R2, cid, p2, A2, w2, F2)@s)
   & not (Ex R2 c2 p2 A2 w2 F2 #s. IStart(P, R2, c2, p2, A2, w2, F2)@s)
   & not (Ex #q. RevLtk(P)@q)"

#endif

/* ---- Lemmas: the responder's state (-D=RESPONDER_STATE) ---- */

#ifdef RESPONDER_STATE

lemma responder_heal_keys_secret_with_its_state [reuse, heuristic={states_then_keys}]:
  "(All Ini Rsp cid S2 rk ck #i #b #j.
       RHeal(Rsp, cid, S2, rk, ck)@i & ISentKey(Ini, cid, 'm3', S2)@b
       & KU(rk)@j
       ==> F)
 & (All Ini Rsp cid S2 rk ck #i #b #j.
       RHeal(Rsp, cid, S2, rk, ck)@i & ISentKey(Ini, cid, 'm3', S2)@b
       & KU(ck)@j
       ==> F)"

/* Bob's state opens the initiator's next message, m3 ... */

lemma responder_state_opens_m3 [heuristic={states_then_keys}]: exists-trace
  "Ex Ini Rsp cid p0 Ai w0 F m1 r1 m #s #t #a #b #c #i #k #j.
     IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & ISent(Ini, Rsp, cid, 'm1', m1)@t
   & RRecv(Rsp, cid, p0, Ai, w0, 'm1', m1)@a & RSent(Rsp, cid, p0, Ai, w0, 'r1', r1)@b
   & IRecv(Ini, Rsp, cid, p0, Ai, w0, 'r1', r1)@c & ISent(Ini, Rsp, cid, 'm3', m)@i
   & RevStateR(Rsp, cid)@k & K(m)@j & not (Ex P #n. RevLtk(P)@n)"

/* ... and his reply to it is secret again, once he has read the initiator's
   own ratchet key. */

lemma r2_heals_after_the_responder_state:
  "All Rsp cid p0 Ai w0 S2 m Ini #i #a #b #j.
     RSent(Rsp, cid, p0, Ai, w0, 'r2', m)@i & RRecvKey(Rsp, cid, 'm3', S2)@a & ISentKey(Ini, cid, 'm3', S2)@b
   & K(m)@j
     ==> F"

/* ... and that healing is reached: the state stolen, then m3 read on the
   initiator's own S2, and r2 sent. Without it, the two lemmas above could
   hold of nothing. */
lemma responder_state_then_r2_reached [heuristic={states_then_keys}]: exists-trace
  "Ex Ini Rsp cid p0 Ai w0 F m1 r1 m3 r2 S2 #s #t #a #b #c #i #x #k #e #y #f.
     IStart(Ini, Rsp, cid, p0, Ai, w0, F)@s & ISent(Ini, Rsp, cid, 'm1', m1)@t
   & RRecv(Rsp, cid, p0, Ai, w0, 'm1', m1)@a & RSent(Rsp, cid, p0, Ai, w0, 'r1', r1)@b
   & IRecv(Ini, Rsp, cid, p0, Ai, w0, 'r1', r1)@c & ISent(Ini, Rsp, cid, 'm3', m3)@i
   & ISentKey(Ini, cid, 'm3', S2)@x & RevStateR(Rsp, cid)@k
   & RRecv(Rsp, cid, p0, Ai, w0, 'm3', m3)@e & RRecvKey(Rsp, cid, 'm3', S2)@y
   & RSent(Rsp, cid, p0, Ai, w0, 'r2', r2)@f
   & not (Ex P #n. RevLtk(P)@n)"

#endif

end
