+/// The one-UTxO order, the reference's own (l6reference#6): Purpose::Pay's and Purpose::Fund's ranks as the rule and
+/// the Purpose docs state them, then among boxes of one rank a mixed one, a plain one, one of unknown making.
+fn own_rank(spend: &Spend, kind: Kind) -> (u8, u8) {
+    match spend {
+        Spend::Send(_) | Spend::Public(_) => match kind {
+            Kind::Own => (0, 0),
+            Kind::OwnSession | Kind::OtherSession => (1, 0),
+            Kind::Received => (2, 0),
+            Kind::Mixed => (4, 0),
+            Kind::Plain => (5, 1),
+            Kind::Unknown => (5, 2),
+        },
+        Spend::Fund(_) => match kind {
+            Kind::OwnSession => (0, 0),
+            Kind::Received => (1, 0),
+            Kind::Mixed => (2, 0),
+            Kind::Plain => (3, 1),
+            Kind::Unknown => (3, 2),
+            Kind::Own => (6, 0),
+            Kind::OtherSession => (7, 0),
+        },
+    }
+}
