+/// l6words#2's sibling, not the finding: c's other money sorts "joins the tokens' class" before size too. A Send of a
+/// token from B (2 ₳ and the token, money made private) and 45 ₳, beside 25 more UTxOs made private of 2 ₳ (B's class),
+/// Y (a payment received of 40 ₳) and K (a plain box of 4.71 ₳): B, Y and a few pay with no box (rule 3).
+#[test]
+fn l6words_2_sibling_a_token_send_merges_no_box_the_others_pay_without() {
+    let w = world();
+    let mut n = 7_100_000u32;
+    let mut next = || {
+        n += 1;
+        n
+    };
+    let mut items = vec![
+        (utxo(&w, next(), 4_710_000, None), Kind::Plain),
+        (utxo(&w, next(), 40 * ADA, None), Kind::Received),
+        (utxo(&w, next(), 2 * ADA, Some("tok")), Kind::Own),
+    ];
+    for _ in 0..25 {
+        items.push((utxo(&w, next(), 2 * ADA, None), Kind::Own));
+    }
+    let balance = Balance {
+        items,
+        boxes: 1,
+        distinct: 2,
+        smalls: 25,
+    };
+    let token = seedelf_core::assets::Asset::new(TOKEN_POLICY.to_string(), hex::encode("tok"), 1).unwrap();
+    let mut paying = Paying {
+        w: &w,
+        seedelfs: vec![Payment {
+            register: w.owner.clone().rerandomize().unwrap(),
+            lovelace: 45 * ADA,
+            tokens: Assets::new().add(token).unwrap(),
+        }],
+        addresses: Vec::new(),
+        known: BTreeMap::new(),
+        builds: 0,
+    };
+    let available: Vec<UtxoResponse> = balance.items.iter().map(|(u, _)| u.clone()).collect();
+    let h = balance.histories(Purpose::Pay, true);
+    let (y, b) = (&balance.items[1].0, &balance.items[2].0);
+    let smalls: Vec<&UtxoResponse> = balance.items[3..].iter().map(|(u, _)| u).collect();
+    let fewest = (0..=20).find(|&k| {
+        let inputs: Vec<&UtxoResponse> = [b, y].into_iter().chain(smalls[..k].iter().copied()).collect();
+        paying.verdict(&inputs) == Verdict::Pays
+    });
+    let picked = paying.apart(&available, &h).expect("it pays");
+    let text = describe_inputs(&balance, &picked);
+    println!("B, Y and {fewest:?} more pay with no box; selection picked {text}");
+    assert!(fewest.is_some(), "B, Y and a few should pay");
+    assert!(
+        !picked.iter().any(|u| u.tx_hash == balance.items[0].0.tx_hash),
+        "a box merged where B, Y and {fewest:?} more pay without one: {text}"
+    );
+}
