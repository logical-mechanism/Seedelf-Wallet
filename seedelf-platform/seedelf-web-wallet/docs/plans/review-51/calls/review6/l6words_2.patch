+/// l6words#2 (round six's focused last look): one box `box_kind` of `box_lovelace`, S (another session's money, 40 ₳)
+/// and 25 payments received of 2 ₳: more small payments than one transaction spends beside a funding's last resort.
+fn l6words_2_balance(w: &World, box_kind: Kind, box_lovelace: u64, small_kind: Kind) -> Balance {
+    let mut n = 7_000_000u32;
+    let mut next = || {
+        n += 1;
+        n
+    };
+    let mut items = vec![
+        (utxo(w, next(), box_lovelace, None), box_kind),
+        (utxo(w, next(), 40 * ADA, None), Kind::OtherSession),
+    ];
+    for _ in 0..25 {
+        items.push((utxo(w, next(), 2 * ADA, None), small_kind));
+    }
+    Balance {
+        items,
+        boxes: 1,
+        distinct: 1,
+        smalls: 25,
+    }
+}
+
+/// A new session's funding of 45 ₳ and its 5 ₳ collateral. No UTxO pays alone, and no set without S pays in one
+/// transaction (22 inputs); S and a few payments do. By the box rule, the box of unknown making goes in only where the
+/// others can't pay without it (rule 2), and a box at all only where none pays (rule 3), before the purpose's order.
+#[test]
+fn l6words_2_a_funding_merges_no_box_the_others_pay_without() {
+    let w = world();
+    let spend = Spend::Fund(45 * ADA);
+    let mut wrong = Vec::new();
+    for (box_kind, box_lovelace, small_kind) in [
+        (Kind::Unknown, 4_710_000, Kind::Received),
+        (Kind::Unknown, 4_710_000, Kind::Own),
+        (Kind::Unknown, 40 * ADA, Kind::Received),
+        (Kind::Plain, 4_710_000, Kind::Received),
+    ] {
+        let balance = l6words_2_balance(&w, box_kind, box_lovelace, small_kind);
+        let available: Vec<UtxoResponse> = balance.items.iter().map(|(u, _)| u.clone()).collect();
+        let h = balance.histories(spend.purpose(), true);
+        let mut paying = Paying::new(&w, &spend);
+        // Without the box: S and the fewest payments that pay.
+        let s = &balance.items[1].0;
+        let smalls: Vec<&UtxoResponse> = balance.items[2..].iter().map(|(u, _)| u).collect();
+        let fewest = (0..=21).find(|&k| {
+            let inputs: Vec<&UtxoResponse> = std::iter::once(s).chain(smalls[..k].iter().copied()).collect();
+            paying.verdict(&inputs) == Verdict::Pays
+        });
+        let picked = paying.apart(&available, &h);
+        let box_in = picked
+            .as_ref()
+            .map(|inputs| inputs.iter().any(|u| u.tx_hash == balance.items[0].0.tx_hash));
+        println!(
+            "{box_kind:?} box of {}, 25 {small_kind:?} of 2 ₳: S and {fewest:?} of them pay without it; selection picked {}",
+            ada(box_lovelace),
+            match &picked {
+                Ok(inputs) => describe_inputs(&balance, inputs),
+                Err(e) => format!("nothing: {e}"),
+            }
+        );
+        let mut tally = Tally::default();
+        if let Err(e) = check(&w, &balance, &spend, &mut tally) {
+            wrong.push(format!(
+                "{box_kind:?} box of {}, smalls {small_kind:?} (box spent: {box_in:?}): {e}",
+                ada(box_lovelace)
+            ));
+        }
+    }
+    assert!(
+        wrong.is_empty(),
+        "the box rule breaks where a funding's last resort lets the rest pay ({} of 4):\n{}",
+        wrong.len(),
+        wrong.join("\n")
+    );
+}
