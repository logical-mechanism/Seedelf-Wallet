--- seedelf-platform/seedelf-core/tests/mint_test.rs	2026-11-19 06:45:05.348971307 -0800
+++ seedelf-platform/seedelf-core/tests/mint_test.rs	2026-11-19 07:59:54.363317242 -0800
@@ -4540,6 +4540,180 @@
             blind.estimate().unwrap().fee.total
         );
