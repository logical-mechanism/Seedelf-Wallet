+    /// l8still#2 (trace check): rule 2 at the first box of unknown making, where 1e1b0647's orders miss the set that
+    /// pays too. T1 and T2, two plain ways back of one token pool, 6 ₳ and its token each; T3, a plain way back of
+    /// another token a little larger than either (6.05 ₳ of another policy, or 6.02 ₳ of another pool of the same
+    /// policy); A, a plain way back of 5.9 ₳; U, a way back of unknown making of 10 ₳; 20 payments received of 10 ₳.
+    /// Halfway between the most any other pair of known boxes pays beside the 20 and the most T1, T2 and the 20 pay:
+    /// of every choice without U, only T1, T2 and the 20 pay (checked over every set of known boxes, as many payments
+    /// beside as 22 inputs hold), and U, A and the 20 pay. Rule 2: T1, T2 and the 20, never U.
+    #[test]
+    fn l8still_2_beside_a_third_token_box_a_box_of_unknown_making_stays_out_where_two_ways_back_of_one_pool_pay()
+    {
+        const OTHER_POLICY: &str = "d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0";
+        let w = world();
+        let of_other_policy = |mut x: UtxoResponse| {
+            for asset in x.asset_list.iter_mut().flatten() {
+                asset.policy_id = OTHER_POLICY.to_string();
+            }
+            x
+        };
+        let a = owned(&w, 0x31, 0, 5_900_000, &[]);
+        let t1 = owned(&w, 0x70, 0, 6_000_000, &[("pooltoken", 1)]);
+        let t2 = owned(&w, 0x71, 0, 6_000_000, &[("pooltoken", 1)]);
+        let u = owned(&w, 0x32, 0, 10_000_000, &[]);
+        let payments: Vec<UtxoResponse> = (0..20u8)
+            .map(|i| owned(&w, 0x50 + i, 0, 10_000_000, &[]))
+            .collect();
+        let shapes = [
+            (
+                "T3 of another policy, 6.05 ₳",
+                of_other_policy(owned(&w, 0x72, 0, 6_050_000, &[("othertoken", 1)])),
+            ),
+            (
+                "T3 of another pool of the same policy, 6.02 ₳",
+                owned(&w, 0x72, 0, 6_020_000, &[("pooltokeB", 1)]),
+            ),
+        ];
+        let both = with_first(&[&t1, &t2], &payments, 20);
+        let mut wrong = Vec::new();
+        for (shape, t3) in &shapes {
+            let names = [(&a, "A"), (&t1, "T1"), (&t2, "T2"), (t3, "T3"), (&u, "U")];
+            let known_boxes = [&a, &t1, &t2, t3];
+            for out in [Out::Send, Out::Public, Out::Fund] {
+                let most = most_paid(150_000_000, 230_000_000, |l| {
+                    pays_out(&w, &both, out, l).is_ok()
+                });
+                let best_other = [[&a, &t1], [&a, &t2], [&a, t3], [&t1, t3], [&t2, t3]]
+                    .iter()
+                    .map(|pair| {
+                        let s = with_first(pair, &payments, 20);
+                        most_paid(150_000_000, 230_000_000, |l| pays_out(&w, &s, out, l).is_ok())
+                    })
+                    .max()
+                    .unwrap();
+                assert!(best_other < most, "{shape}, {out:?}: no window ({best_other} >= {most})");
+                let lovelace = most - (most - best_other) / 2;
+                // The premises: of every set of known boxes, as many payments beside as 22 inputs hold, only T1, T2
+                // and the 20 pay; U and the 20 are short, U, A and the 20 pay, and 23 inputs are too many.
+                for mask in 1u8..16 {
+                    let chosen: Vec<&UtxoResponse> = (0..4)
+                        .filter(|j| mask >> j & 1 == 1)
+                        .map(|j| known_boxes[j])
+                        .collect();
+                    let s = with_first(&chosen, &payments, 20.min(22 - chosen.len()));
+                    let paid = pays_out(&w, &s, out, lovelace);
+                    if mask == 0b0110 {
+                        paid.unwrap_or_else(|e| panic!("{shape}, {out:?}: T1, T2 and the 20 pay: {e}"));
+                    } else {
+                        let e = paid.expect_err("only T1, T2 and the 20 pay without U");
+                        assert!(build::is_short(&e), "{shape}, {out:?}: mask {mask:04b}: {e}");
+                    }
+                }
+                let e = pays_out(&w, &with_first(&[&u], &payments, 20), out, lovelace).unwrap_err();
+                assert!(build::is_short(&e), "{shape}, {out:?}: U and the 20: {e}");
+                pays_out(&w, &with_first(&[&u, &a], &payments, 20), out, lovelace)
+                    .unwrap_or_else(|e| panic!("{shape}, {out:?}: U, A and the 20 pay: {e}"));
+                let e = pays_out(&w, &with_first(&[&a, &t1, &t2], &payments, 20), out, lovelace)
+                    .unwrap_err();
+                assert!(build::is_too_many(&e), "{shape}, {out:?}: 23 inputs: {e}");
+                let mut known: Vec<(&UtxoResponse, Class)> = vec![
+                    (&a, box_class(&a, Origin::Lovejoin)),
+                    (&t1, box_class(&t1, Origin::Lovejoin)),
+                    (&t2, box_class(&t2, Origin::Lovejoin)),
+                    (t3, box_class(t3, Origin::Lovejoin)),
+                    (&u, unknown_class(&u)),
+                ];
+                known.extend(payments.iter().map(|p| (p, received_class(p))));
+                let line = format!(
+                    "{shape}: {out:?} of {lovelace} (T1, T2 and the 20 pay up to {most}, any other pair beside the 20 \
+                     up to {best_other})"
+                );
+                match picked_out(&w, &known, out, lovelace) {
+                    Ok(spent) if outpoints(&spent) == outpoints(&both) => println!("{line}: spent T1, T2 and the 20"),
+                    Ok(spent) => {
+                        let l = format!("{line}: spent {}", named(&spent, &names));
+                        println!("{l}");
+                        wrong.push(l);
+                    }
+                    Err(e) => {
+                        let l = format!("{line}: refused: {e}");
+                        println!("{l}");
+                        wrong.push(l);
+                    }
+                }
+            }
+        }
+        assert!(
+            wrong.is_empty(),
+            "a box of unknown making merged where T1, T2 and the 20 pay without one, beside a third token box:\n{}",
+            wrong.join("\n")
+        );
+    }
