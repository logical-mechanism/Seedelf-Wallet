+/// Chunk 51, round eight's last look (l8merge#4): where the other money holds tokens, selection weighs every box
+/// twice, beside a change of ADA alone and beside the change its order keeps (l7merge#2), and each least it works out
+/// makes the sizing datum again. Twenty UTxOs of money made private, 20 kinds each, beside 250 boxes of unknown making,
+/// each holding a pool's token, and 250 plain ones of ADA alone: a Send, a funding, one too large for one transaction
+/// and a Make public, each in a fraction of round seven's time once a least no longer makes the datum again.
+#[test]
+fn token_boxes_beside_money_holding_many_kinds_plan_in_a_fraction_of_a_second() {
+    let w = world();
+    let p = &w.chain.params;
+    let mut n = 0x2000_0000u32;
+    let mut items: Vec<(UtxoResponse, Kind)> = Vec::new();
+    for k in 0..20u32 {
+        n += 1;
+        let mut u = utxo(&w, n, 0, None);
+        u.asset_list = Some(
+            (0..20)
+                .map(|i| Asset {
+                    decimals: 0,
+                    quantity: "1".into(),
+                    policy_id: format!("{:02x}", 0x20 + k).repeat(28),
+                    asset_name: hex::encode(format!("k{k}m{i:02}")),
+                    fingerprint: String::new(),
+                })
+                .collect(),
+        );
+        let (_, kinds) = seedelf_core::utxos::assets_of(vec![u.clone()]).unwrap();
+        u.value = (build::minimum_deposit(p, &kinds).unwrap() + ADA / 2).to_string();
+        items.push((u, Kind::Own));
+    }
+    for i in 0..500u32 {
+        n += 1;
+        let lovelace = [4_710_000, 9_710_000, 19_710_000, 24_710_000][(n % 4) as usize];
+        let (token, kind) = if i < 250 {
+            (Some(format!("pool{i}")), Kind::Unknown)
+        } else {
+            (None, Kind::Plain)
+        };
+        items.push((utxo(&w, n, lovelace, token.as_deref()), kind));
+    }
+    let balance = Balance {
+        boxes: 500,
+        distinct: 20,
+        smalls: 0,
+        small: 2 * ADA,
+        items,
+    };
+    let available: Vec<UtxoResponse> = balance.items.iter().map(|(u, _)| u.clone()).collect();
+    let mut worst = std::time::Duration::ZERO;
+    for (spend, builds) in [
+        (Spend::Send(100 * ADA), true),
+        (Spend::Fund(95 * ADA), true),
+        (Spend::Send(2_000 * ADA), false),
+        (Spend::Public(400 * ADA), true),
+    ] {
+        let paying = Paying::new(&w, &spend);
+        let h = balance.histories(spend.purpose(), true);
+        // The best of three, so a load spike on a shared runner doesn't decide it.
+        let (took, picked) = (0..3)
+            .map(|_| {
+                let started = std::time::Instant::now();
+                let picked = paying.apart(&available, &h);
+                (started.elapsed(), picked)
+            })
+            .min_by_key(|(took, _)| *took)
+            .unwrap();
+        worst = worst.max(took);
+        println!(
+            "{spend:?}: {} in {took:?}",
+            match &picked {
+                Ok(inputs) => format!("{} inputs", inputs.len()),
+                Err(e) => format!("refused ({e})"),
+            }
+        );
+        assert_eq!(picked.is_ok(), builds, "{spend:?}");
+    }
+    // On one machine (an i5-12400F, chunk 51, l8merge#4), the slowest of these, the best of three: round seven's code
+    // 0.31 to 0.34 s in a debug build and 0.17 to 0.23 s in release; round eight's 0.41 to 0.44 s and 0.23 to 0.48 s
+    // (load 4 to 14); with the sizing datum made once, 0.2 to 0.23 s and 0.07 to 0.085 s, at load up to 20.
+    let bound = if cfg!(debug_assertions) { 300 } else { 150 };
+    assert!(
+        worst < std::time::Duration::from_millis(bound),
+        "the slowest selection took {worst:?}"
+    );
+}
+
 /// `unknown` boxes of unknown making and `plain` plain ones of 10 ₳, beside `received` payments of 2 ₳: one
