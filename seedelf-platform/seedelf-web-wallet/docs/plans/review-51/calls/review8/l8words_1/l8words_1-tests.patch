+
+    /// D: no P, no TP. Q, a plain way back of another token pool, 5.15 ₳ and a Z of another policy, weighs more than T1
+    /// and T2 and is larger, but beside either is short.
+    #[test]
+    fn l8words_1_d_a_way_back_of_another_pool_beside_the_pair() {
+        const OTHER_POLICY: &str = "d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0";
+        let w = world();
+        let money = l8w_money(&w);
+        let t1 = owned(&w, 0x40, 0, 5_100_000, &[("Y", 1)]);
+        let t2 = owned(&w, 0x41, 0, 5_100_000, &[("Y", 1)]);
+        let mut q = owned(&w, 0x45, 0, 5_150_000, &[("Z", 1)]);
+        for asset in q.asset_list.iter_mut().flatten() {
