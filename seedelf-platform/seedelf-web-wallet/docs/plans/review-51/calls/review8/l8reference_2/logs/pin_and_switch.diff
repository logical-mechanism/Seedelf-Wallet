+
+    /// Chunk 51, round eight (l8reference#2): only an order of every UTxO marks a spend short (`short_whole`). The pass
+    /// before the first box of unknown making grows 1e1b0647's orders over the rest without any: whole there, but not
+    /// everything. 22 plain boxes of 13.19 ₳ (290.18 ₳) beside 10 of unknown making of 10 ₳, a Send of 290 ₳: the 22
+    /// plain ones hold more than it pays out and are short by its fee, every other set of 22 holds less, and every set
+    /// of 23 is too many. So it's refused as too many for one transaction, which the wallet's parts take, not as short.
+    #[test]
+    fn a_send_short_beside_all_but_the_boxes_of_unknown_making_stays_too_many_for_one_transaction() {
+        let w = world();
+        let (all, h) = balance(
+            &w,
+            Purpose::Pay,
+            &[
+                (22, 13_190_000, None, Made::Plain),
+                (10, 10 * ADA, None, Made::Unknown),
+            ],
+        );
+        let pay = [Payment {
+            register: w.owner.clone().rerandomize().unwrap(),
+            lovelace: 290 * ADA,
+            tokens: Assets::new(),
+        }];
+        let outputs = payment_outputs(&w.chain, &pay).unwrap();
+        let plain = &all[..22];
+        assert!(
+            plain.iter().map(lovelace_of).sum::<u64>() > paid_out(&outputs),
+            "the pass before the first box of unknown making asks the 22 plain ones"
+        );
+        let alone = paying(&w.chain, plain, &outputs, &w.owner, w.signer)
+            .and_then(|spend| spend.estimate().map(|_| ()));
+        assert!(
+            alone.as_ref().is_err_and(is_short),
+            "the 22 plain ones are short by the fee: {alone:?}"
+        );
+        let picked = select_script_inputs(
+            &w.chain.params,
+            &all,
+            &Assets::new(),
+            paid_out(&outputs),
+            &h,
+            |inputs| {
+                let spend = paying(&w.chain, inputs, &outputs, &w.owner, w.signer)?;
+                spend.estimate()?;
+                Ok(spend)
+            },
+        );
+        let e = picked.map(|spend| spend.inputs().len()).expect_err("no set of 22 or fewer pays");
+        println!("refused: {e} (too many: {}, short: {})", is_too_many(&e), is_short(&e));
+        assert!(
+            is_too_many(&e),
+            "refused as too many for one transaction, so the wallet's parts take it: {e}"
+        );
+    }
 }
