+    /// l7still#2, shape A (review scratch): where only 1e1b0647's a builds, by its order of the boxes (the purpose's
+    /// rank first: a mixed one before a plain one), pass d's a sends it in one. 19 payments received of 10 ₳ and ZH, one
+    /// of 10 ₳ and a token Z; M, a mixed way back of 5 ₳; TM, a mixed way back of 5.1 ₳ and a Z; P, a plain way back of
+    /// 5.02 ₳; TP, a plain way back of 7 ₳ and 19 tokens. Just under the most the 20, M and TM pay in 22 inputs: TM beside
+    /// ZH's Z pays all its ADA but weighs a Z's least less, so the rule's orders take P and M; d's c takes P and TP, or TP
+    /// and TM; e and 1e1b0647's b take P and M: all short, and 23 inputs are too many.
+    #[test]
+    fn l7still_2_where_only_1e1b0647s_a_builds_it_still_goes_in_one() {
+        let w = world();
+        let money: Vec<UtxoResponse> = (0..19u8)
+            .map(|i| owned(&w, 0x10 + i, 0, 10_000_000, &[]))
+            .collect();
+        let zh = owned(&w, 0x30, 0, 10_000_000, &[("Z", 1)]);
+        let m = owned(&w, 0x40, 0, 5_000_000, &[]);
+        let tm = owned(&w, 0x41, 0, 5_100_000, &[("Z", 1)]);
+        let p = owned(&w, 0x42, 0, 5_020_000, &[]);
+        let names: Vec<String> = (0..19)
+            .map(|i| format!("{i:02}{}", "n".repeat(30)))
+            .collect();
+        let many: Vec<(&str, u64)> = names.iter().map(|n| (n.as_str(), 1)).collect();
+        let tp = owned(&w, 0x43, 0, 7_000_000, &many);
+        let with = |extra: &[&UtxoResponse]| -> Vec<UtxoResponse> {
+            money
+                .iter()
+                .cloned()
+                .chain(std::iter::once(zh.clone()))
+                .chain(extra.iter().map(|u| (*u).clone()))
+                .collect()
+        };
+        let target = with(&[&m, &tm]);
+        let (mc, tmc) = (box_class(&m, Origin::Mixed), box_class(&tm, Origin::Mixed));
+        let (pc, tpc) = (
+            box_class(&p, Origin::Lovejoin),
+            box_class(&tp, Origin::Lovejoin),
+        );
+        let weight = |u: &UtxoResponse, c: &Class| {
+            build::box_weight(&w.chain.params, c, &[u], build::Weighed::InOne).0
+        };
+        let (wp, wm, wtm, wtp) = (
+            weight(&p, &pc),
+            weight(&m, &mc),
+            weight(&tm, &tmc),
+            weight(&tp, &tpc),
+        );
+        println!("weights: P {wp}, M {wm}, TM {wtm}, TP {wtp}");
+        assert!(wp > wm && wm > wtm && wtm > wtp, "the weights' premise");
+        let mut known: Vec<(&UtxoResponse, Class)> =
+            money.iter().map(|u| (u, received_class(u))).collect();
+        known.push((&zh, received_class(&zh)));
+        known.push((&m, mc));
+        known.push((&tm, tmc));
+        known.push((&p, pc));
+        known.push((&tp, tpc));
+        let mut wrong = Vec::new();
+        for out in [Out::Send, Out::Public, Out::Fund] {
+            let most = most_paid(150_000_000, 230_000_000, |l| {
+                pays_out(&w, &target, out, l).is_ok()
+            });
+            let lovelace = most - 10_000;
+            for (what, inputs) in [
+                ("the 20, P and M", with(&[&p, &m])),
+                ("the 20, P and TP", with(&[&p, &tp])),
+                ("the 20, M and TP", with(&[&m, &tp])),
+                ("the 20, TP and TM", with(&[&tp, &tm])),
+            ] {
+                let e = pays_out(&w, &inputs, out, lovelace).unwrap_err();
+                assert!(build::is_short(&e), "{out:?}: {what}: {e}");
+            }
+            let e = pays_out(&w, &with(&[&m, &tm, &p]), out, lovelace).unwrap_err();
+            assert!(build::is_too_many(&e), "{out:?}: 23 inputs: {e}");
+            match picked_out(&w, &known, out, lovelace) {
+                Ok(spent) if outpoints(&spent) == outpoints(&target) => {
+                    println!("{out:?} of {lovelace}: the 20, M and TM")
+                }
+                Ok(spent) => wrong.push(format!(
+                    "{out:?} of {lovelace}: spent {} inputs, not the 20, M and TM",
+                    spent.len()
+                )),
+                Err(e) => wrong.push(format!(
+                    "{out:?} of {lovelace} (the 20, M and TM pay up to {most}): refused: {e}"
+                )),
+            }
+        }
+        assert!(
+            wrong.is_empty(),
+            "refused, or another set, where 1e1b0647's a sent the 20, M and TM as one transaction:\n{}",
+            wrong.join("\n")
+        );
+    }
+
+    /// l7still#2, shape S (review scratch): where only 1e1b0647's step 1 builds, pass d's singles send it in one. A Send
+    /// of 21 of a token Q, held one each by 21 UTxOs of 2 ₳ (the first holds an R too), which leave room for one UTxO
+    /// more in one transaction. X, a way back of unknown making of 10 ₳ and an R, of the first holder's history; P*, a
+    /// plain way back of 9.95 ₳, and P1 to P12, plain ways back of 11 ₳ and 19 tokens, of the second's. Just under the
+    /// most the 21 and X pay: step 1 here asks the twelve plain ones first (plain before unknown making) and at its cap
+    /// passes X by; 1e1b0647's asked X second, the smallest after P*. Joining the tokens' history, every box ranks as
+    /// one the wallet knows, and the merge weighs P* above X (X's R pays beside the first holder's R, which its weight
+    /// doesn't see): P* is short, and two beside the 21 are too many.
+    #[test]
+    fn l7still_2_where_only_1e1b0647s_step_1_builds_it_still_goes_in_one() {
+        use seedelf_core::assets::Asset as Token;
+        let w = world();
+        let holders: Vec<UtxoResponse> = (0..21u8)
+            .map(|i| {
+                let tokens: &[(&str, u64)] = if i == 0 {
+                    &[("Q", 1), ("R", 1)]
+                } else {
+                    &[("Q", 1)]
+                };
+                owned(&w, 0x10 + i, 0, 2_000_000, tokens)
+            })
+            .collect();
+        let x = owned(&w, 0x40, 0, 10_000_000, &[("R", 1)]);
+        let p_star = owned(&w, 0x41, 0, 9_950_000, &[]);
+        let names: Vec<String> = (0..19)
+            .map(|i| format!("{i:02}{}", "n".repeat(30)))
+            .collect();
+        let many: Vec<(&str, u64)> = names.iter().map(|n| (n.as_str(), 1)).collect();
+        let ps: Vec<UtxoResponse> = (0..12u8)
+            .map(|i| owned(&w, 0x50 + i, 0, 11_000_000, &many))
+            .collect();
+        let unknown = class("box:kk+unknown:kk", Origin::Lovejoin);
+        let plain = class("box:ll", Origin::Lovejoin);
+        let mut known: Vec<(&UtxoResponse, Class)> = holders
+            .iter()
+            .enumerate()
+            .map(|(i, u)| {
+                let c = match i {
+                    0 => unknown.clone(),
+                    1 => plain.clone(),
+                    _ => received_class(u),
+                };
+                (u, c)
+            })
+            .collect();
+        known.push((&x, unknown.clone()));
+        known.push((&p_star, plain.clone()));
+        known.extend(ps.iter().map(|u| (u, plain.clone())));
+        let q21 = Assets::new()
+            .add(Token::new(TOKEN_POLICY.to_string(), hex::encode("Q"), 21).unwrap())
+            .unwrap();
+        let send = |lovelace: u64| Payment {
+            register: Register::create(random_scalar())
+                .unwrap()
+                .rerandomize()
+                .unwrap(),
+            lovelace,
+            tokens: q21.clone(),
+        };
+        let with = |extra: &[&UtxoResponse]| -> Vec<UtxoResponse> {
+            holders
+                .iter()
+                .cloned()
+                .chain(extra.iter().map(|u| (*u).clone()))
+                .collect()
+        };
+        let pays = |inputs: &[UtxoResponse], lovelace: u64| pays_many(&w, inputs, &[send(lovelace)], &[]);
+        let target = with(&[&x]);
+        let most = most_paid(40_000_000, 60_000_000, |l| pays(&target, l).is_ok());
+        let lovelace = most - 10_000;
+        for (what, inputs) in [
+            ("the 21 alone", with(&[])),
+            ("the 21 and P*", with(&[&p_star])),
+            ("the 21 and P1", with(&[&ps[0]])),
+        ] {
+            let e = pays(&inputs, lovelace).unwrap_err();
+            assert!(build::is_short(&e), "{what}: {e}");
+        }
+        let e = pays(&with(&[&x, &p_star]), lovelace).unwrap_err();
+        assert!(build::is_too_many(&e), "23 inputs: {e}");
+        let weight = |u: &UtxoResponse, c: &Class| {
+            build::box_weight(&w.chain.params, c, &[u], build::Weighed::InOne).0
+        };
+        let (wx, wp) = (weight(&x, &unknown), weight(&p_star, &plain));
+        println!("weights: X {wx}, P* {wp}");
+        assert!(wp > wx, "the weights' premise");
+        match picked_by(&w, Purpose::Pay, &known, &[send(lovelace)], &[]) {
+            Ok(spent) if outpoints(&spent) == outpoints(&target) => {
+                println!("a Send of 21 Q and {lovelace}: the 21 and X")
+            }
+            Ok(spent) => panic!(
+                "a Send of 21 Q and {lovelace}: spent {} inputs, not the 21 and X",
+                spent.len()
+            ),
+            Err(e) => panic!(
+                "a Send of 21 Q and {lovelace} (the 21 and X pay up to {most}), which 1e1b0647's step 1 sent as one \
+                 transaction: refused: {e}"
+            ),
+        }
+    }
 }
 
