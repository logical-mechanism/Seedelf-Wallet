+/// Review scratch (l7reference#2): boxes of ADA alone between what a token pool's way back pays beside a change and
+/// the ADA it holds, one such way back to a balance, amounts near what one box and the other money pay. Weighed by its
+/// ADA, or by what it adds, a token pool's way back goes on the wrong side of such a box.
+const BAND_SHAPE: Shape = Shape {
+    sizes: BAND,
+    near: true,
+    one_token_box: true,
+    ..DEFAULT
+};
+
+#[test]
+fn selection_picks_the_best_set_by_the_box_rule_where_a_weight_could_disagree_with_the_ada_a_box_holds() {
+    let tally = sweep(650..670, BAND_SHAPE);
+    assert!(tally.merged > 0, "{tally:?}");
+}
+
+#[test]
+fn selection_picks_the_best_set_by_the_box_rule_where_a_weight_could_disagree_with_the_ada_a_box_holds_too() {
+    let tally = sweep(670..690, BAND_SHAPE);
+    assert!(tally.merged > 0, "{tally:?}");
+}
+
+/// Review scratch: the same over more seeds (L7R2_FROM, L7R2_COUNT), past the input limit with L7R2_LIMIT, to count
+/// how often each weight is caught.
+#[test]
+#[ignore]
+fn band_explore() {
+    let var = |name: &str, or: u64| {
+        std::env::var(name)
+            .ok()
+            .and_then(|s| s.parse().ok())
+            .unwrap_or(or)
+    };
+    let (from, count) = (var("L7R2_FROM", 600), var("L7R2_COUNT", 200));
+    let limit = std::env::var_os("L7R2_LIMIT").is_some();
+    let shape = Shape {
+        sizes: BAND,
+        most_boxes: var("L7R2_MOST", 6),
+        past_the_limit: limit,
+        small: if limit { 5 * ADA } else { 2 * ADA },
+        near: true,
+        one_token_box: std::env::var_os("L7R2_ANY").is_none(),
+        ..DEFAULT
+    };
+    sweep(from..from + count, shape);
+}
+
 /// The sweep: many more balances, of up to eight boxes, of every shape above.
 #[test]
 #[ignore]
