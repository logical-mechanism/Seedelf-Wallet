+/// Review (l7reference#1): the most `make` pays with exactly `inputs`, to 1,000 lovelace.
+fn most_paid_by(w: &World, make: &dyn Fn(u64) -> Spend, inputs: &[&UtxoResponse]) -> u64 {
+    let pays = |l: u64| Paying::new(w, &make(l)).verdict(inputs) == Verdict::Pays;
+    let mut hi: u64 = inputs.iter().map(|u| lovelace_of(u)).sum();
+    let mut lo = hi / 2;
+    assert!(pays(lo) && !pays(hi), "the target set pays half and not all it holds");
+    while hi - lo > 1_000 {
+        let mid = lo + (hi - lo) / 2;
+        if pays(mid) {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    lo
+}
