+/// Review (l7reference#1): the band part, boxes of ADA alone just above a token box's weight and below its ADA beside
+/// two ways back of one token pool and 18 to 25 payments of 10 ₳, amounts just under what the pair and 20 payments
+/// pay: rule 1 strictly (never refused where a set pays), and where a pair of one pool pays at the best level, the
+/// documented margin of one box more, rules 4 and 5 unasked. No box of unknown making here.
+#[test]
+fn review_band_where_a_pair_of_one_pool_pays_more_than_its_weights() {
+    let (tally, wrong) = band_sweep(7_000..7_060, false, true);
+    assert!(tally.merged > 0 && tally.past_the_limit > 0, "{tally:?}");
+    assert!(
+        wrong.is_empty(),
+        "selection's pick isn't the best by the box rule ({} of them):\n{}",
+        wrong.len(),
+        wrong.join("\n")
+    );
+}
