+/// Review (l7reference#1): the band where two ways back of one token pool pay more than the rule's per-box weights
+/// say (that token's share of the change's least, 172,400 lovelace, counted once by the pair and once by each
+/// weight): T1 and T2 of 6 ₳ and poolA's token beside one or two boxes of ADA alone of 5.9 ₳, or of 7.5 ₳ beside
+/// 7.4 ₳, each box weighing more than either token box and paying less; maybe one of 4.71 ₳; maybe one other UTxO;
+/// 18 to 25 payments received of 10 ₳. Amounts just under what the pair, the other money and as many payments as one
+/// transaction spends beside them pay. With `unknown`, a box may be of unknown making.
+fn band_balance(w: &World, seed: u64, unknown: bool) -> (Balance, Vec<Spend>) {
+    let mut rng = Rng(seed.wrapping_mul(0x9e37_79b9_7f4a_7c15) | 1);
+    let mut n = u32::try_from(seed % 100_000).unwrap() * 64;
+    let mut next = || {
+        n += 1;
+        n
+    };
+    let band = rng.below(2) as usize;
+    let (pair, beside) = ([6_000_000, 7_500_000][band], [5_900_000, 7_400_000][band]);
+    let kind = |rng: &mut Rng| match rng.below(100) {
+        0..40 => Kind::Mixed,
+        40..75 => Kind::Plain,
+        _ if unknown => Kind::Unknown,
+        _ => Kind::Plain,
+    };
+    let mut boxes: Vec<(UtxoResponse, Kind)> = Vec::new();
+    for _ in 0..2 {
+        let k = kind(&mut rng);
+        boxes.push((utxo(w, next(), pair, Some("poolA")), k));
+    }
+    for _ in 0..1 + rng.below(2) {
+        let k = kind(&mut rng);
+        boxes.push((utxo(w, next(), beside, None), k));
+    }
+    if rng.below(2) == 0 {
+        let k = kind(&mut rng);
+        boxes.push((utxo(w, next(), 4_710_000, None), k));
+    }
+    for i in (1..boxes.len()).rev() {
+        let j = rng.below(i as u64 + 1) as usize;
+        boxes.swap(i, j);
+    }
+    let nb = boxes.len();
+    let mut items = boxes;
+    let distinct = rng.below(2) as usize;
+    let mut kinds = vec![Kind::Own, Kind::Received, Kind::OwnSession, Kind::OtherSession];
+    for _ in 0..distinct {
+        let k = kinds.remove(rng.below(kinds.len() as u64) as usize);
+        let lovelace = [1_500_000, 2_000_000, 3_000_000][rng.below(3) as usize];
+        items.push((utxo(w, next(), lovelace, None), k));
+    }
+    let smalls = 18 + rng.below(8) as usize;
+    for _ in 0..smalls {
+        items.push((utxo(w, next(), 10 * ADA, None), Kind::Received));
+    }
+    let balance = Balance {
+        items,
+        boxes: nb,
+        distinct,
+        smalls,
+        small: 10 * ADA,
+    };
+    let fit = (22 - 2 - distinct).min(smalls);
+    let target: Vec<&UtxoResponse> = (0..nb)
+        .filter(|&i| holds_tokens(&balance.items[i].0))
+        .map(|i| &balance.items[i].0)
+        .chain(balance.items[nb..nb + distinct + fit].iter().map(|(u, _)| u))
+        .collect();
+    let mut near = |make: &dyn Fn(u64) -> Spend| -> u64 {
+        most_paid_by(w, make, &target) - rng.below(10) * (ADA / 100)
+    };
+    let send = near(&Spend::Send);
+    let public = near(&Spend::Public);
+    let fund = near(&Spend::Fund);
+    (
+        balance,
+        vec![Spend::Send(send), Spend::Public(public), Spend::Fund(fund)],
+    )
+}
+
+fn band_sweep(seeds: std::ops::Range<u64>, unknown: bool, margin: bool) -> (Tally, Vec<String>) {
+    let w = world();
+    let mut tally = Tally::default();
+    let mut wrong = Vec::new();
+    let range = format!("{seeds:?}");
+    let before = review_d();
+    for seed in seeds {
+        let (balance, spends) = band_balance(&w, seed, unknown);
+        for spend in &spends {
+            if let Err(e) = check_with(&w, &balance, spend, &mut tally, margin) {
+                wrong.push(format!("seed {seed}: {e}"));
+            }
+        }
+    }
+    let after = review_d();
+    let d: Vec<usize> = (0..8).map(|i| after[i] - before[i]).collect();
+    println!(
+        "REVIEW_D band seeds {range} unknown {unknown}: d entered {}, built by d's singles {}, by d's a/b {}, by d's c {} (j = 0: {}), by e after d {}, refused after d {}",
+        d[0], d[1], d[2], d[3], d[4], d[5], d[6]
+    );
+    println!("{tally:?}");
+    (tally, wrong)
+}
+
