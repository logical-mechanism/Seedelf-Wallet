+/// Review scratch only (l7still#2): a mutation of pass d, named in `L7S2_MUT` (comma-separated).
+fn l7s2_mut(name: &str) -> bool {
+    std::env::var("L7S2_MUT").is_ok_and(|v| v.split(',').any(|p| p == name))
+}
+
+/// Review scratch only (l7still#2): which step built, with `L7S2_TRACE` set.
+fn l7s2_trace(what: &str) {
+    if std::env::var("L7S2_TRACE").is_ok() {
+        eprintln!("l7s2: {what}");
+    }
+}
