+    /// Whether exactly `inputs` pay a Send of `seedelf` (`pay` empty) or a payment of `pay`, as selection's attempt
+    /// checks it (built, and its computation estimated).
+    fn pays_with(
+        w: &World,
+        inputs: &[UtxoResponse],
+        seedelf: &Payment,
+        pay: &[AddressPayment],
+    ) -> anyhow::Result<()> {
+        let spend = if pay.is_empty() {
+            build::transfer_from(
+                &w.chain,
+                inputs,
+                std::slice::from_ref(seedelf),
+                &w.owner,
+                w.signer,
+            )?
+        } else {
+            build::sweep_many_from(&w.chain, inputs, pay, &w.owner, w.signer)?
+        };
+        spend.estimate().map(|_| ())
+    }
