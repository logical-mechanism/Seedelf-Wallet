+    /// l5words#3 (a): architecture.md:144 says of the box order "So it spends as few boxes as pay". Five ways back the
+    /// wallet knows are mixed, 4.71 ₳ each, and W, one of unknown making, 24.71 ₳: 26 ₳ out, W and one other pay as
+    /// two.
+    #[test]
+    fn l5words_3a_as_few_boxes_as_pay_with_a_larger_box_of_unknown_making() {
+        let w = world();
+        let known: Vec<(UtxoResponse, Class)> = (0..5u8)
+            .map(|i| {
+                let u = owned(&w, 0x50 + i, 0, 4_710_000, &[]);
+                let c = class(&format!("box:{}", u.tx_hash), Origin::Mixed);
+                (u, c)
+            })
+            .collect();
+        let unplaced = owned(&w, 0x70, 0, 24_710_000, &[]);
+        let unplaced_class = class(
+            &format!("box:{0}+unknown:{0}", unplaced.tx_hash),
+            Origin::Lovejoin,
+        );
+        let mut all: Vec<(&UtxoResponse, Class)> =
+            known.iter().map(|(u, c)| (u, c.clone())).collect();
+        all.push((&unplaced, unplaced_class));
+        let seedelf = paying(26_000_000);
+        let two = [unplaced.clone(), known[0].0.clone()];
+        let mut wrong = Vec::new();
+        for (name, purpose, pay) in [
+            ("a Send of 26 ₳ to a Seedelf", Purpose::Pay, Vec::new()),
+            (
+                "a Make public of 26 ₳",
+                Purpose::Pay,
+                to_address(26_000_000),
+            ),
+            (
+                "a new session's funding of 21 ₳ and its 5 ₳ collateral",
+                Purpose::Fund {
+                    session: Some("session:7".into()),
+                },
+                funding(21_000_000),
+            ),
+        ] {
+            let two_pay = pays_with(&w, &two, &seedelf, &pay);
+            assert!(two_pay.is_ok(), "{name}: W and one other pay: {two_pay:?}");
+            let spent = spent_by(&w, purpose, &all, &seedelf, &pay);
+            let line = format!("{name}: {} boxes spent, where 2 pay", spent.len());
+            println!("{line}");
+            if spent.len() > 2 {
+                wrong.push(line);
+            }
+        }
+        assert!(
+            wrong.is_empty(),
+            "not as few boxes as pay:\n{}",
+            wrong.join("\n")
+        );
+    }
