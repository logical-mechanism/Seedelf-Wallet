+    /// l5words#3 (b), beside it, step 1: the policy's "a private payment ... take a box it knows is mixed before one it
+    /// can't tell the making of". Twelve bundles of a token made private (3 ₳ each), X a token pool's way back the
+    /// wallet knows is mixed (20 ₳ and its token), W one of unknown making (20 ₳). A Send of 12 ₳: X and W each pay
+    /// alone.
+    #[test]
+    fn l5words_3b_step_one_takes_a_token_pools_mixed_way_back_before_one_of_unknown_making() {
+        let w = world();
+        let bundles: Vec<UtxoResponse> = (0..12u64)
+            .map(|i| owned(&w, 0x10, i, 3_000_000, &[("nft", 1)]))
+            .collect();
+        let token_box = owned(&w, 0x60, 0, 20_000_000, &[("tok", 1_000)]);
+        let unplaced = owned(&w, 0x30, 0, 20_000_000, &[]);
+        let mut known: Vec<(&UtxoResponse, Class)> = bundles
+            .iter()
+            .map(|u| (u, class("public:0", Origin::Own)))
+            .collect();
+        known.push((
+            &token_box,
+            class(&format!("box:{}", token_box.tx_hash), Origin::Mixed),
+        ));
+        known.push((
+            &unplaced,
+            class(
+                &format!("box:{0}+unknown:{0}", unplaced.tx_hash),
+                Origin::Lovejoin,
+            ),
+        ));
+        let seedelf = paying(12_000_000);
+        let x_pays = pays_with(&w, std::slice::from_ref(&token_box), &seedelf, &[]);
+        assert!(x_pays.is_ok(), "X pays alone: {x_pays:?}");
+        let spent = outpoints(&spent_by(&w, Purpose::Pay, &known, &seedelf, &[]));
+        println!("a Send of 12 ₳: spent {spent:?}");
+        assert_eq!(
+            spent,
+            one(&token_box),
+            "the box of unknown making taken alone where the mixed one pays alone"
+        );
+    }
