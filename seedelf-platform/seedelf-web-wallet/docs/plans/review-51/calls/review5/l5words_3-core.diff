+    /// l5words#3 (b): privacy.md:173 says one tagged Unknown goes "after every other box", and the policy that a funding
+    /// and a private payment "take a box it knows is mixed before one it can't tell the making of". K, a plain way back
+    /// of 4.71 ₳; W, one of unknown making, 9.71 ₳; X, a token pool's way back the wallet knows is mixed, 9.71 ₳ and
+    /// its pool's token. 12 ₳ out: K and X pay as two.
+    #[test]
+    fn l5words_3b_a_box_of_unknown_making_goes_after_a_token_pools_mixed_way_back() {
+        let w = world();
+        let plain = owned(&w, 0x41, 0, 4_710_000, &[]);
+        let unplaced = owned(&w, 0x30, 0, BOX, &[]);
+        let token_box = owned(&w, 0x60, 0, BOX, &[("tok", 1_000)]);
+        let known = [
+            (
+                &plain,
+                class(&format!("box:{}", plain.tx_hash), Origin::Lovejoin),
+            ),
+            (
+                &unplaced,
+                class(
+                    &format!("box:{0}+unknown:{0}", unplaced.tx_hash),
+                    Origin::Lovejoin,
+                ),
+            ),
+            (
+                &token_box,
+                class(&format!("box:{}", token_box.tx_hash), Origin::Mixed),
+            ),
+        ];
+        let seedelf = paying(12_000_000);
+        let with_mixed = [plain.clone(), token_box.clone()];
+        let mut wrong = Vec::new();
+        for (name, purpose, pay) in [
+            ("a Send of 12 ₳ to a Seedelf", Purpose::Pay, Vec::new()),
+            (
+                "a Make public of 12 ₳",
+                Purpose::Pay,
+                to_address(12_000_000),
+            ),
+            (
+                "a new session's funding of 7 ₳ and its 5 ₳ collateral",
+                Purpose::Fund {
+                    session: Some("session:7".into()),
+                },
+                funding(7_000_000),
+            ),
+        ] {
+            let pays = pays_with(&w, &with_mixed, &seedelf, &pay);
+            assert!(pays.is_ok(), "{name}: K and X pay: {pays:?}");
+            let spent = outpoints(&spent_by(&w, purpose, &known, &seedelf, &pay));
+            let line = format!("{name}: spent {spent:?}");
+            println!("{line}");
+            if spent.contains(&one(&unplaced)[0]) && !spent.contains(&one(&token_box)[0]) {
+                wrong.push(line);
+            }
+        }
+        assert!(
+            wrong.is_empty(),
+            "a box of unknown making merged ahead of a box the wallet knows is mixed:\n{}",
+            wrong.join("\n")
+        );
+    }
