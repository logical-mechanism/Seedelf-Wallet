{
  "name": "seedelf-web-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Seedelf web wallet: a Chrome (MV3) extension for the Cardano stealth wallet",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:wasm": "../wasm/build.sh",
    "build:ext": "vite build",
    "build": "npm run build:wasm && npm run build:ext",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
