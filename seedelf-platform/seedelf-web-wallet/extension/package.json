{
  "name": "seedelf-web-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Seedelf web wallet: a Chrome (MV3) extension for the Cardano stealth wallet",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:wasm": "../wasm/build.sh",
    "build:ext": "vite build",
    "build": "npm run build:wasm && npm run build:ext",
    "build:store": "VITE_STORE_BUILD=true npm run build",
    "package": "npm run build:store && node scripts/package.mjs",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test --project=extension",
    "store:images": "playwright test --project=store"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
