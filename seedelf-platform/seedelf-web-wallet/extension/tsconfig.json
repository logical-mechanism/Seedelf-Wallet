{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "vite/client", "node"],
    "paths": {
      "@seedelf/wasm": ["../wasm/pkg/seedelf_wasm.d.ts"]
    }
  },
  "include": ["src", "tests", "e2e", "vite.config.ts", "playwright.config.ts"]
}
