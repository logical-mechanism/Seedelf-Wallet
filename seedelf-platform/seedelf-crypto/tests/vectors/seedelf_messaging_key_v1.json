  "spec": "seedelf-messaging-key-v1",
  "frozen": "Not yet: frozen when Seedelf Messaging opens on mainnet (protocol.md §21.2). From then on never edit these values: every web wallet's messages depend on them.",
  "sibling_of": "seedelf_key_v1.json, never a change to it: the same phrases and the same seed, under another salt and info, so x_m is never v1's x",
  "derivation": {
    "seed": "BIP39 seed of the phrase: PBKDF2-HMAC-SHA512, 2048 rounds, salt \"mnemonic\" (empty passphrase), 64 bytes, the seed v1 takes",
    "okm_m": "HKDF-SHA-256(ikm = seed, salt = \"seedelf-messaging-v1\", info = \"seedelf-messaging-key\" || u32_be(account) || network || generation, L = 64)",
    "x_m": "int_be(okm_m) mod r (BLS12-381 scalar field order), 32 bytes big-endian; zero is rejected",
    "public_value": "compressed G1 point G1^x_m"
  },
  "network": "one byte: 0 preprod, 1 mainnet; any other is refused",
  "generation": "one byte: 0 in v1, the next byte at each rotation",
  "coverage": "every phrase of seedelf_key_v1.json at account 0: both networks at generation 0, and generation 1 on preprod and mainnet in turn; account 1 once, to pin the account's byte order",
  "cross_checked": "seed, okm_m and x_m against Python hashlib/hmac; public_value against a pure-Python BLS12-381 G1 (py_ecc wasn't installed) that first reproduces every value in seedelf_key_v1.json",
