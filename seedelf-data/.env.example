# Copy to .env (git ignores it) and fill in. Never commit real values.
#
# db-sync, through a read-only role (SELECT only, default_transaction_read_only).
MAINNET_DATABASE_URL=postgresql://seedelf_reader:<password>@<host>:5432/<db>
# The Seedelf-only Kupo: the private index's second source.
MAINNET_KUPO_URL=http://<host>:1443
# cardano-submit-api and Ogmios, for the submit part.
MAINNET_SUBMIT_API_URL=http://<host>:8090
MAINNET_OGMIOS_URL=http://<host>:1337
# Tokens' decimals from the Cardano token registry (scripts/token-decimals.py).
# Without it, every token's decimals are 0.
MAINNET_TOKEN_DECIMALS=/path/to/token-decimals.json
# Where the API listens. Loopback by default: there are no limits in front of it yet.
DATA_LISTEN=127.0.0.1:8099
