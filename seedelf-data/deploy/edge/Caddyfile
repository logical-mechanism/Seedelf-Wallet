# /etc/caddy/Caddyfile on the VPS. Caddy does TLS and passes requests on;
# every limit is the API's own (src/edge.rs). It names the client in
# X-Forwarded-For, which the API trusts from loopback alone.
{
	# Caddy's own log, less the loggers that carry a request: an error's
	# entry names the client's address and the path it asked for. Check it
	# with a forced error (deploy/README.md, "Checks").
	log default {
		output stderr
		exclude http.log.error http.handlers.reverse_proxy
	}
	# No `email`: Let's Encrypt has sent no expiry notices since 2025, and
	# Caddy renews by itself. Watch renewals in the journal instead.
}

mainnet.<domain> {
	# No `log` directive: no access log.
	request_body {
		# The largest body the API takes (an evaluation): KiB, as the API
		# counts. Caddy's KB is 1,000 bytes, and its 413 carries no CORS.
		max_size 64KiB
	}
	reverse_proxy 127.0.0.1:8099 {
		transport http {
			# A submit waits up to 30 s on home.
			response_header_timeout 40s
		}
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
