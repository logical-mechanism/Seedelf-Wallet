# /etc/caddy/Caddyfile on the VPS. Caddy does TLS and passes requests on;
# every limit on what a client may ask is the API's own (src/edge.rs), and
# Caddy's own are its timeouts. It names the client in X-Forwarded-For,
# which the API trusts from loopback alone.
{
	# Caddy's own log, less the loggers that carry a request: an error's
	# entry names the client's address and the path it asked for. Check it
	# with a forced error (deploy/README.md, "Checks").
	log default {
		output stderr
		exclude http.log.error http.handlers.reverse_proxy
	}
	# Every request ends. Without these, Caddy's defaults put no deadline on
	# a body or an answer, so a client that stops half way holds its
	# connection, and Caddy's to the API, for as long as it likes.
	# read_header and read_body: the head, and then the whole request,
	# within 10 s of its start (the API gives a body 10 s too). write: the
	# answer within 60 s of the head, past a submit's 30 to 40 s (the
	# response_header_timeout below) and the wallet's longest wait, 35 s.
	# idle: a connection with nothing asked closes after 2 minutes.
	# protocols: HTTP/1.1 and HTTP/2 only. Caddy's write timeout isn't shown
	# to end a stalled HTTP/3 answer, and Chrome falls back to HTTP/2 with
	# nothing lost. UDP 443 stays open in nftables.conf; nothing listens.
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 10s
			write 60s
			idle 2m
		}
	}
	# No `email`: Let's Encrypt has sent no expiry notices since 2025, and
	# Caddy renews by itself. Watch renewals in the journal instead.
}

mainnet.<domain> {
	# No `log` directive: no access log.
	request_body {
		# The largest body the API takes (an evaluation): KiB, as the API
		# counts. Caddy's KB is 1,000 bytes, and its 413 carries no CORS.
		max_size 64KiB
	}
	reverse_proxy 127.0.0.1:8099 {
		transport http {
			# A submit waits up to 30 s on home.
			response_header_timeout 40s
		}
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
