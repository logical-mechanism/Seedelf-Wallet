# /etc/seedelf-data/env on the VPS: mode 0600, owned by root. systemd reads
# it before the service drops to its own user. Never commit real values.

# Home's services, through the tunnel.
MAINNET_DATABASE_URL=postgresql://seedelf_reader:<password>@10.88.0.2:5432/<db-sync database>
MAINNET_KUPO_URL=http://10.88.0.2:1443
MAINNET_SUBMIT_API_URL=http://10.88.0.2:8090
MAINNET_OGMIOS_URL=http://10.88.0.2:1337

# Caddy, on this machine, is the only way in.
DATA_LISTEN=127.0.0.1:8099
DATA_TRUST_PROXY=true

# The wallet's origin from the Web Store, comma-separated with any others.
DATA_ORIGINS=chrome-extension://<the Web Store extension ID>

# The API's own traffic a month, in GB, before it answers 503 (the node's
# P2P traffic through the tunnel isn't counted: watch the VPS's own meter).
DATA_EGRESS_GB_MONTH=<GB>

# Its start, and failures by kind: never an address, a path or a body.
RUST_LOG=info
