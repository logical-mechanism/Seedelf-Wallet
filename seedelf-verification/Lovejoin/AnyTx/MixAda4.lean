def boxOut (M : ByteString) (bl : Integer) (a b : ByteString) : Data :=
  .Constr 0 [.Constr 0 [.Constr 1 [.B M], .Constr 1 []],
    .Map [(.B "", .Map [(.B "", .I bl)])], .Constr 2 [.Constr 0 [.B a, .B b]], .Constr 1 []]

def argsWithOutputs (P M : ByteString) (bl : Integer) (a1 b1 a2 b2 a3 b3 a4 b4 oa1 ob1 oa2 ob2 oa3 ob3 oa4 ob4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (o : Tail) (p : Proofs) (boxOutputs : List Data) : List Term :=
  let tx := { f.tx with outputs := .List (boxOutputs ++ [keyOut o]) }
  let inputs := .List [boxIn f.boxRef M f.boxStake f.boxValue f.boxScript a1 b1,
      boxIn bx2.ref M bx2.stake bx2.value bx2.script a2 b2,
      boxIn bx3.ref M bx3.stake bx3.value bx3.script a3 b3,
      boxIn bx4.ref M bx4.stake bx4.value bx4.script a4 b4,
      otherIn f.keyRef 0 key f.keyStake f.keyValue f.keyDatum f.keyScript]
  let refs := .List [carrierRef f.carrierRef f.carrierAddr (.Map [(.B "", .I 2000000)]) f.carrierScript
    P M bl "" "" 0 800000 testL testL]
  let red := proofsRedeemerPool p.t011 p.t111 p.c11 p.z11 p.t012 p.t112 p.c12 p.z12 p.t013 p.t113 p.c13 p.z13 p.t014 p.t114 p.c14 p.z14 p.t021 p.t121 p.c21 p.z21 p.t022 p.t122 p.c22 p.z22 p.t023 p.t123 p.c23 p.z23 p.t024 p.t124 p.c24 p.z24 p.t031 p.t131 p.c31 p.z31 p.t032 p.t132 p.c32 p.z32 p.t033 p.t133 p.c33 p.z33 p.t034 p.t134 p.c34 p.z34 p.t041 p.t141 p.c41 p.z41 p.t042 p.t142 p.c42 p.z42 p.t043 p.t143 p.c43 p.z43 p.t044 p.t144 p.c44 p.z44
  [toTerm P, toTerm nftName, toTerm (Data.Constr 0 [withInputs tx inputs refs f.sigs, red, .Constr 2 [f.acct]])]

def args (P M : ByteString) (bl : Integer) (a1 b1 a2 b2 a3 b3 a4 b4 oa1 ob1 oa2 ob2 oa3 ob3 oa4 ob4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (o : Tail) (p : Proofs) : List Term :=
  argsWithOutputs P M bl a1 b1 a2 b2 a3 b3 a4 b4 oa1 ob1 oa2 ob2 oa3 ob3 oa4 ob4 key f bx2 bx3 bx4 o p [boxOut M bl oa1 ob1, boxOut M bl oa2 ob2, boxOut M bl oa3 ob3, boxOut M bl oa4 ob4]

