import Lovejoin.AnyTx.OwnerTwo
import Blaster

/-! Owner withdrawal of 4 boxes and a following key input. Outputs, input references,
input values and unused transaction fields are arbitrary. The sole carrier uses the
fixed reference value and datum shape in `OwnerOne`. Generated by
`gen-lovejoin-anytx-owners.py`. -/
namespace Lovejoin.AnyTx.Owner4
open CardanoLedgerApi.IsData.Class (toTerm)
open PlutusCore.ByteString (ByteString)
open PlutusCore.Data (Data)
open PlutusCore.UPLC.Term (Term)
open PlutusCore.UPLC.Utils
open Seedelf.V1 (returnsUnit)
open Lovejoin.Classic (wellFormed)
open Lovejoin.Template (nftName)
open Lovejoin.AnyTx
open Lovejoin.AnyTx.OwnerOne (Fields)
open Lovejoin.AnyTx.OwnerTwo (BoxFields)

structure Proofs where
  t1 : ByteString
  z1 : ByteString
  t2 : ByteString
  z2 : ByteString
  t3 : ByteString
  z3 : ByteString
  t4 : ByteString
  z4 : ByteString

def argsWithProofs (P M a1 b1 a2 b2 a3 b3 a4 b4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (proofs : List Data) : List Term :=
  [toTerm P, toTerm nftName, toTerm (ownerCtx f.tx
    (.List [boxIn f.boxRef M f.boxStake f.boxValue f.boxScript a1 b1,
      boxIn bx2.ref M bx2.stake bx2.value bx2.script a2 b2,
      boxIn bx3.ref M bx3.stake bx3.value bx3.script a3 b3,
      boxIn bx4.ref M bx4.stake bx4.value bx4.script a4 b4,
      otherIn f.keyRef 0 key f.keyStake f.keyValue f.keyDatum f.keyScript])
    (.List [carrierRef f.carrierRef f.carrierAddr (.Map [(.B "", .I 2000000)]) f.carrierScript
      P M 10000000 "" "" 0 800000 testL testL]) f.sigs f.acct proofs)]

def args (P M a1 b1 a2 b2 a3 b3 a4 b4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (p : Proofs) : List Term :=
  argsWithProofs P M a1 b1 a2 b2 a3 b3 a4 b4 key f bx2 bx3 bx4 [proofData p.t1 p.z1, proofData p.t2 p.z2, proofData p.t3 p.z3, proofData p.t4 p.z4]

def missingArgs (P M a1 b1 a2 b2 a3 b3 a4 b4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (p : Proofs) : List Term :=
  argsWithProofs P M a1 b1 a2 b2 a3 b3 a4 b4 key f bx2 bx3 bx4 [proofData p.t1 p.z1, proofData p.t2 p.z2, proofData p.t3 p.z3]

#prep_uplc owner4Tx mixLogicTemplate args 30000
#prep_uplc owner4Missing mixLogicTemplate missingArgs 30000

/-- Box 1's own proof is required. -/
theorem box1_needs_proof (P M a1 b1 a2 b2 a3 b3 a4 b4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (p : Proofs) :
    wellFormed a1 b1 = true →
    wellFormed a2 b2 = true →
    wellFormed a3 b3 = true →
    wellFormed a4 b4 = true →
    ownProof M f.tx.outputs [f.boxRef, bx2.ref, bx3.ref, bx4.ref, f.keyRef] a1 b1 p.t1 p.z1 = false →
    isUnsuccessful (owner4Tx.prop P M a1 b1 a2 b2 a3 b3 a4 b4 key f bx2 bx3 bx4 p) := by blaster (timeout: 540)

/-- Box 2's own proof is required. -/
theorem box2_needs_proof (P M a1 b1 a2 b2 a3 b3 a4 b4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (p : Proofs) :
    wellFormed a1 b1 = true →
    wellFormed a2 b2 = true →
    wellFormed a3 b3 = true →
    wellFormed a4 b4 = true →
    ownProof M f.tx.outputs [f.boxRef, bx2.ref, bx3.ref, bx4.ref, f.keyRef] a2 b2 p.t2 p.z2 = false →
    isUnsuccessful (owner4Tx.prop P M a1 b1 a2 b2 a3 b3 a4 b4 key f bx2 bx3 bx4 p) := by blaster (timeout: 540)

/-- Box 3's own proof is required. -/
theorem box3_needs_proof (P M a1 b1 a2 b2 a3 b3 a4 b4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (p : Proofs) :
    wellFormed a1 b1 = true →
    wellFormed a2 b2 = true →
    wellFormed a3 b3 = true →
    wellFormed a4 b4 = true →
    ownProof M f.tx.outputs [f.boxRef, bx2.ref, bx3.ref, bx4.ref, f.keyRef] a3 b3 p.t3 p.z3 = false →
    isUnsuccessful (owner4Tx.prop P M a1 b1 a2 b2 a3 b3 a4 b4 key f bx2 bx3 bx4 p) := by blaster (timeout: 540)

/-- Box 4's own proof is required. -/
theorem box4_needs_proof (P M a1 b1 a2 b2 a3 b3 a4 b4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (p : Proofs) :
    wellFormed a1 b1 = true →
    wellFormed a2 b2 = true →
    wellFormed a3 b3 = true →
    wellFormed a4 b4 = true →
    ownProof M f.tx.outputs [f.boxRef, bx2.ref, bx3.ref, bx4.ref, f.keyRef] a4 b4 p.t4 p.z4 = false →
    isUnsuccessful (owner4Tx.prop P M a1 b1 a2 b2 a3 b3 a4 b4 key f bx2 bx3 bx4 p) := by blaster (timeout: 540)

/-- All well-formed boxes and valid proofs pass in this layout. -/
theorem valid_proofs_pass (P M a1 b1 a2 b2 a3 b3 a4 b4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (p : Proofs) :
    P ≠ "" →
    wellFormed a1 b1 = true →
    wellFormed a2 b2 = true →
    wellFormed a3 b3 = true →
    wellFormed a4 b4 = true →
    ownProof M f.tx.outputs [f.boxRef, bx2.ref, bx3.ref, bx4.ref, f.keyRef] a1 b1 p.t1 p.z1 = true →
    ownProof M f.tx.outputs [f.boxRef, bx2.ref, bx3.ref, bx4.ref, f.keyRef] a2 b2 p.t2 p.z2 = true →
    ownProof M f.tx.outputs [f.boxRef, bx2.ref, bx3.ref, bx4.ref, f.keyRef] a3 b3 p.t3 p.z3 = true →
    ownProof M f.tx.outputs [f.boxRef, bx2.ref, bx3.ref, bx4.ref, f.keyRef] a4 b4 p.t4 p.z4 = true →
    returnsUnit (owner4Tx.prop P M a1 b1 a2 b2 a3 b3 a4 b4 key f bx2 bx3 bx4 p) := by blaster (timeout: 540)

/-- 4 well-formed boxes cannot leave with only 3 proofs. -/
theorem missing_proof_fails (P M a1 b1 a2 b2 a3 b3 a4 b4 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (bx4 : BoxFields) (p : Proofs) :
    wellFormed a1 b1 = true →
    wellFormed a2 b2 = true →
    wellFormed a3 b3 = true →
    wellFormed a4 b4 = true →
    isUnsuccessful (owner4Missing.prop P M a1 b1 a2 b2 a3 b3 a4 b4 key f bx2 bx3 bx4 p) := by blaster (timeout: 540)

end Lovejoin.AnyTx.Owner4
