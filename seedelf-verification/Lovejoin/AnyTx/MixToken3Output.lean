import Lovejoin.AnyTx.MixToken3
import Blaster

/-! Every prefix box of the 3-box Token layout must have exactly the pool value.
Two Booleans select the output. Generated by `gen-lovejoin-anytx-mix-outputs.py`. -/
namespace Lovejoin.AnyTx.MixToken3Output
open PlutusCore.ByteString (ByteString)
open PlutusCore.Integer (Integer)
open PlutusCore.Data (Data)
open PlutusCore.UPLC.Term (Term)
open PlutusCore.UPLC.Utils
open Lovejoin.AnyTx.OwnerOne (Fields)
open Lovejoin.AnyTx.OwnerTwo (BoxFields)
open Lovejoin.AnyTx.MixTwo (Tail)
open Lovejoin.AnyTx.MixToken3 (Proofs boxOut argsWithOutputs)
open Lovejoin.V2.Tok3 (boxValuePool)

def badOut (M : ByteString) (value : Data) (a b : ByteString) : Data :=
  .Constr 0 [.Constr 0 [.Constr 1 [.B M], .Constr 1 []], value,
    .Constr 2 [.Constr 0 [.B a, .B b]], .Constr 1 []]

def args (P M : ByteString) (bl : Integer) (tp tn : ByteString) (tq : Integer) (a1 b1 a2 b2 a3 b3 oa1 ob1 oa2 ob2 oa3 ob3 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (o : Tail) (p : Proofs) (bad : Data) (first second : Bool) : List Term :=
  argsWithOutputs P M bl tp tn tq a1 b1 a2 b2 a3 b3 oa1 ob1 oa2 ob2 oa3 ob3 key f bx2 bx3 o p [
    (if first then badOut M bad oa1 ob1 else boxOut M bl tp tn tq oa1 ob1),
    (if !first && second then badOut M bad oa2 ob2 else boxOut M bl tp tn tq oa2 ob2),
    (if !first && !second then badOut M bad oa3 ob3 else boxOut M bl tp tn tq oa3 ob3)]

#prep_uplc anyTxMixToken3BadValue mixLogicTemplate args 65000

theorem wrong_value (P M : ByteString) (bl : Integer) (tp tn : ByteString) (tq : Integer) (a1 b1 a2 b2 a3 b3 oa1 ob1 oa2 ob2 oa3 ob3 key : ByteString) (f : Fields) (bx2 : BoxFields) (bx3 : BoxFields) (o : Tail) (p : Proofs) (bad : Data) (first second : Bool) :
    bad ≠ boxValuePool bl tp tn tq →
    isUnsuccessful (anyTxMixToken3BadValue.prop P M bl tp tn tq a1 b1 a2 b2 a3 b3 oa1 ob1 oa2 ob2 oa3 ob3 key f bx2 bx3 o p bad first second) := by blaster (timeout: 540)

end Lovejoin.AnyTx.MixToken3Output
